# AWS 배포용 server/.env 템플릿 (이슈 #485). 변수 이름과 설명만 있다 — 비밀 값은 서버에서만 채우고 git에 올리지 않는다.
# 쓰는 법: 서버의 <코드 폴더>/server/.env 로 저장해 빈칸을 채운다 (pm2의 cwd가 server/라 이 파일을 읽는다).
# "erp.example.com"은 Caddy에 넣은 도메인으로 바꾼다.

# ── 운영 모드 ──────────────────────────────────────────────
# production이면 JWT_SECRET·DATABASE_URL·CORS_ORIGIN이 없거나 JWT_SECRET이 로컬 기본값일 때 서버가 뜨지 않는다
NODE_ENV=production
API_PORT=8787

# ── DB (Supabase) ──────────────────────────────────────────
# Supabase → Connect → ORM → Prisma에서 복사한다. 한 벌만 둔다 (같은 파일에 로컬 주소를 남기지 않는다: 뒤에 오는 줄이 앞을 덮는다)
# 서버가 쓰는 주소: Transaction pooler(6543) + ?pgbouncer=true
DATABASE_URL=
# 마이그레이션·generate:sql이 쓰는 주소: Session pooler(5432)
DIRECT_URL=

# ── 로그인 ─────────────────────────────────────────────────
# 새 값으로 만든다 (로컬 기본값이면 서버가 뜨지 않는다). 바꾸면 모두 다시 로그인할 뿐 사원 비밀번호와는 상관없다
#   만들기: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h
# https에서는 COOKIE_SECURE를 넣지 않는다 (넣지 않으면 Secure 쿠키)

# ── 주소 ───────────────────────────────────────────────────
# 사원이 여는 화면 주소 (쿠키를 주고받는 곳)
CORS_ORIGIN=https://erp.example.com
# OAuth(Notion·Google)를 마치고 돌아갈 화면 주소
CLIENT_BASE_URL=https://erp.example.com
# 브라우저가 서버에 닿는 주소. Notion·Google 허용 뒤 돌아오는 주소가 <이 값>/integrations/oauth/callback 이 된다
SERVER_PUBLIC_URL=https://erp.example.com/api/v1

# ── 저장 폴더 ───────────────────────────────────────────────
# 코드 폴더 밖에 둔다 (git pull·다시 받기에 지워지지 않게). 메신저 첨부와 화면 설정(settings/*.json)이 여기 쌓인다.
# 화면 '관리 > AI 연결'에서 저장하면 이 폴더의 settings/llm.json·stt.json이 아래 LLM_*·STT_* 값보다 먼저다. 백업 대상이다.
STORAGE_DIR=/var/lib/fantasteel/storage

# ── LLM (사용자 Mac, Tailscale) ─────────────────────────────
# Mac의 Tailscale 주소 + LLM 서버 포트 + /v1. Mac의 LLM 서버가 127.0.0.1이 아니라 Tailscale 주소로도 받아야 한다. Funnel은 쓰지 않는다
#   예: http://<Mac의 Tailscale IP>:<포트>/v1
LLM_BASE_URL=
# 비우면 화면 '관리 > AI 연결'에서 고른다
LLM_MODEL=
# Mac LLM 서버의 API 키 (서버에서만 채운다)
LLM_API_KEY=

# ── 음성 (사용자 Mac 음성 서버, Tailscale) ───────────────────
# 음성 서버(8001)는 Funnel로 열지 않는다. tailnet 안에서만 부른다
STT_BASE_URL=
# 비우면 화면 '관리 > AI 연결'에서 고른다
STT_MODEL=
# Mac 음성 서버의 API 키
STT_API_KEY=

# ── 외부 연결 (Notion·Google Drive) ─────────────────────────
# 저장된 연결(토큰)을 암호화하는 키. 바꾸면 저장된 연결을 다시 해야 한다. Notion은 AWS 주소로 다시 연결한다 (Mac에서 한 연결은 옮겨지지 않는다)
INTEGRATION_SECRET_KEY=
# 비우면 https://mcp.notion.com/mcp
NOTION_MCP_URL=
# Google Drive 서비스 계정 키. 둘 중 하나:
#   파일: 키 파일을 서버의 server/secrets/ 에 scp로 복사하고 상대 경로를 적는다 (server/secrets/는 git에 올라가지 않는다)
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=
#   또는 키 JSON의 base64 한 줄 (base64 -i key.json | tr -d '\n')
GOOGLE_SERVICE_ACCOUNT_KEY=
# 녹음·사진·문서 Drive 폴더 주소 또는 id
GOOGLE_DRIVE_FOLDER=

# ── 철강맨AI 검색 ───────────────────────────────────────────
# 네이버 키는 없으면 비워 둔다
KAKAO_REST_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 웹 페이지 읽기·브라우저에서 막을 호스트(쉼표). 사내망 IP와 이 서버 자신은 늘 막는다
WEB_FETCH_DENY_HOSTS=

# ── AI 브라우저 (처음에는 끈다) ──────────────────────────────
# 서버에 Google Chrome을 깔았을 때만 true. 4GB 서버에서는 램을 아끼려고 처음에는 false
AI_BROWSER_ENABLED=false
# 서버에는 모니터가 없다
BROWSER_HEADLESS=true
# Chrome을 기본 위치 밖에 깔았을 때만
BROWSER_EXECUTABLE_PATH=
# root로 띄우지 않는다(일반 사용자로 pm2 실행). 샌드박스는 켠 채로 둔다 (넣지 않는다)
# BROWSER_NO_SANDBOX=
BROWSER_VISION=

# ── ERP 화면 조작 (시험 중, 끈다) ─────────────────────────────
AI_SCREEN_CONTROL_ENABLED=false

# SEED_PASSWORD는 넣지 않는다: 시드는 서버에서 돌리지 않는다 (DB 반영은 개발 PC에서 npm run db:deploy -w @fantasteel/server)
