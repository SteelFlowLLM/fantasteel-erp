{
  "name": "@fantasteel/server",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "generate": "prisma generate",
    "generate:sql": "prisma generate --sql",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "tsx prisma/seed.ts",
    "check-orphans": "node scripts/check-orphans.mjs",
    "db:prepare": "node scripts/prepare-db.mjs",
    "test": "node scripts/test.mjs",
    "test:unit": "node scripts/test.mjs --unit"
  },
  "dependencies": {
    "@fantasteel/shared": "*",
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/jwt": "*",
    "@nestjs/platform-express": "^12.0.0",
    "@nestjs/platform-socket.io": "^12.0.0",
    "@nestjs/websockets": "^12.0.0",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.0.0",
    "pdfkit": "^0.20.0",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/testing": "^12.0.0",
    "@types/express": "^5.0.1",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/pdfkit": "^0.17.0",
    "@types/pg": "^8.15.0",
    "jest": "^30.0.0",
    "prisma": "^7.0.0",
    "ts-jest": "^29.4.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3"
  }
}
