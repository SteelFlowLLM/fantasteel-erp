// 기준: docs/erd/fantasteel_erp_p1.dbml (ERD). 테이블·컬럼·키·관계는 ERD 그대로다. 바꾸려면 ERD를 먼저 고친다 (코드 컨벤션 7-3).
// 상태값은 String 컬럼 + @fantasteel/shared 상수 (Prisma enum 미사용, 코드 컨벤션 4장).
// DB 외래키 제약은 만들지 않는다 (relationMode = "prisma"). ERD Note의 CHECK·부분 unique는 마이그레이션 SQL에 직접 둔다.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
  previewFeatures = ["typedSql"]
}

datasource db {
  provider     = "postgresql"
  relationMode = "prisma"
}

// ───────────────────────────── 조직·권한 (AUTH, ORG) ─────────────────────────────

model Employee {
  id Int @id @default(autoincrement())
  employeeNo String @unique @map("employee_no") @db.VarChar /// 사원번호(로그인 ID)
  employeeName String @map("employee_name") @db.VarChar
  passwordHash String @map("password_hash") @db.VarChar /// bcrypt. 응답·로그에 내보내지 않음
  departmentId Int @map("department_id")
  jobGradeId Int @map("job_grade_id")
  roleId Int @map("role_id") /// 사원당 역할 1개
  isActive Boolean @default(true) @map("is_active") /// 퇴사 처리. 사원은 삭제하지 않음
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  department Department @relation("EmployeeDepartment", fields: [departmentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  jobGrade JobGrade @relation("EmployeeJobGrade", fields: [jobGradeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  role Role @relation("EmployeeRole", fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  departmentsAsHeadEmployee Department[] @relation("DepartmentHeadEmployee")
  salesOrdersAsOwnerEmployee SalesOrder[] @relation("SalesOrderOwnerEmployee")
  shipmentRequestsAsIssuedEmployee ShipmentRequest[] @relation("ShipmentRequestIssuedEmployee")
  qualityInspectionsAsInspectorEmployee QualityInspection[] @relation("QualityInspectionInspectorEmployee")
  purchaseRequisitionsAsRequester PurchaseRequisition[] @relation("PurchaseRequisitionRequester")
  purchaseRequisitionsAsApprover PurchaseRequisition[] @relation("PurchaseRequisitionApprover")
  businessEventsAsActorEmployee BusinessEvent[] @relation("BusinessEventActorEmployee")
  tasksAsAssignee Task[] @relation("TaskAssignee")
  notificationsAsRecipient Notification[] @relation("NotificationRecipient")
  chatRoomMembers ChatRoomMember[] @relation("ChatRoomMemberEmployee")
  messagesAsSender Message[] @relation("MessageSender")
  messageReactions MessageReaction[] @relation("MessageReactionEmployee")
  actionDraftsAsRequester ActionDraft[] @relation("ActionDraftRequester")

  @@index([departmentId])
  @@index([jobGradeId])
  @@index([roleId])
  @@map("employee")
}

model Department {
  id Int @id @default(autoincrement())
  departmentCode String @unique @map("department_code") @db.VarChar
  departmentName String @map("department_name") @db.VarChar
  parentId Int? @map("parent_id") /// 상위 부서. 순환 금지(service)
  headEmployeeId Int? @map("head_employee_id") /// 부서장 1명. 역할이 아님(REQ-ORG-002). 구매요청 최종 승인권자
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  employees Employee[] @relation("EmployeeDepartment")
  parent Department? @relation("DepartmentParent", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  departmentsAsParent Department[] @relation("DepartmentParent")
  headEmployee Employee? @relation("DepartmentHeadEmployee", fields: [headEmployeeId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([parentId])
  @@index([headEmployeeId])
  @@map("department")
}

model JobGrade {
  id Int @id @default(autoincrement())
  jobGradeName String @map("job_grade_name") @db.VarChar
  sortOrder Int @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  employees Employee[] @relation("EmployeeJobGrade")

  @@map("job_grade")
}

model Role {
  id Int @id @default(autoincrement())
  roleCode String @unique @map("role_code") @db.VarChar /// ROLE: SALES, PURCHASE, PRODUCTION, QUALITY, LOGISTICS, ADMIN
  roleName String @map("role_name") @db.VarChar
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  employees Employee[] @relation("EmployeeRole")
  rolePermissions RolePermission[] @relation("RolePermissionRole")

  @@map("role")
}

model RolePermission {
  id Int @id @default(autoincrement())
  roleId Int @map("role_id")
  permission String @db.VarChar /// PERMISSION
  permissionLevel String @map("permission_level") @db.VarChar /// PERMISSION_LEVEL: USE, VIEW. 권한이 없으면 행을 두지 않음
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  role Role @relation("RolePermissionRole", fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([roleId, permission])
  @@map("role_permission")
}

// ───────────────────────────── 기준정보 (MST) ─────────────────────────────

model SteelGrade {
  id Int @id @default(autoincrement())
  steelGradeCode String @unique @map("steel_grade_code") @db.VarChar /// STEEL_GRADE: SS275, SM355A~D, SPHC
  steelGradeName String @map("steel_grade_name") @db.VarChar
  standardNo String @map("standard_no") @db.VarChar /// KS 규격 번호. 밀시트 표시
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  items Item[] @relation("ItemSteelGrade")
  specificConsumptions SpecificConsumption[] @relation("SpecificConsumptionSteelGrade")
  lots Lot[] @relation("LotSteelGrade")
  inspectionStandards InspectionStandard[] @relation("InspectionStandardSteelGrade")

  @@map("steel_grade")
}

/// / CHECK (마이그레이션 SQL) / - RAW_MATERIAL: unit_type = TON, raw_material_type 필수, 치수·이론중량·steel_grade_id null / - SLAB·COIL: unit_type = QTY, steel_grade_id·치수·theoretical_weight_ton 필수, raw_material_type null / service: 수주·재고·LOT에 사용된 규격은 치수·이론중량 수정 차단(MST-002) /
model Item {
  id Int @id @default(autoincrement())
  itemCode String @unique @map("item_code") @db.VarChar /// 원료 코드(예: ORE01) 또는 규격 코드(예: SL-SS275-250x1500x10000)
  itemName String @map("item_name") @db.VarChar
  itemType String @map("item_type") @db.VarChar /// ITEM_TYPE: RAW_MATERIAL, SLAB, COIL
  unitType String @map("unit_type") @db.VarChar /// UNIT_TYPE: 원료 TON, 제품 QTY
  rawMaterialType String? @map("raw_material_type") @db.VarChar /// RAW_MATERIAL_TYPE. 원료만
  steelGradeId Int? @map("steel_grade_id") /// 제품만
  thicknessMm Decimal? @map("thickness_mm") @db.Decimal(8, 2) /// 제품만
  widthMm Decimal? @map("width_mm") @db.Decimal(8, 2) /// 제품만
  lengthMm Decimal? @map("length_mm") @db.Decimal(8, 2) /// 제품만
  theoreticalWeightTon Decimal? @map("theoretical_weight_ton") @db.Decimal(12, 3) /// 제품만. 두께x폭x길이x7.85/10^9, 소수 3자리 확정값
  defaultYardId Int @map("default_yard_id") /// LOT 생성 시 자동 지정
  defaultSupplierId Int? @map("default_supplier_id") /// 원료만. 품목별 기본 공급업체 1곳
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  steelGrade SteelGrade? @relation("ItemSteelGrade", fields: [steelGradeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  defaultYard Yard @relation("ItemDefaultYard", fields: [defaultYardId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  defaultSupplier Supplier? @relation("ItemDefaultSupplier", fields: [defaultSupplierId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  specMappingAsSlabItem SpecMapping? @relation("SpecMappingSlabItem")
  specMappingAsCoilItem SpecMapping? @relation("SpecMappingCoilItem")
  specificConsumptionsAsRawMaterialItem SpecificConsumption[] @relation("SpecificConsumptionRawMaterialItem")
  salesOrderItems SalesOrderItem[] @relation("SalesOrderItemItem")
  inventory Inventory? @relation("InventoryItem")
  reservations Reservation[] @relation("ReservationItem")
  productionPlans ProductionPlan[] @relation("ProductionPlanItem")
  lots Lot[] @relation("LotItem")
  purchaseRequisitions PurchaseRequisition[] @relation("PurchaseRequisitionItem")
  purchaseOrderItems PurchaseOrderItem[] @relation("PurchaseOrderItemItem")

  @@unique([itemType, steelGradeId, thicknessMm, widthMm, lengthMm]) // 제품 규격 중복 금지
  @@index([steelGradeId])
  @@index([defaultYardId])
  @@index([defaultSupplierId])
  @@map("item")
}

/// / service: 코일 이론중량 <= 슬래브 1매 이론중량 / 열연 계획 수율 = 코일 이론중량 / 슬래브 이론중량 (저장하지 않음) /
model SpecMapping {
  id Int @id @default(autoincrement())
  slabItemId Int @unique @map("slab_item_id") /// 슬래브 규격
  coilItemId Int @unique @map("coil_item_id") /// 대응 코일 규격 1개
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  slabItem Item @relation("SpecMappingSlabItem", fields: [slabItemId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  coilItem Item @relation("SpecMappingCoilItem", fields: [coilItemId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("spec_mapping")
}

model Routing {
  id Int @id @default(autoincrement())
  itemType String @map("item_type") @db.VarChar /// SLAB 또는 COIL
  processType String @map("process_type") @db.VarChar /// PROCESS_TYPE
  sequenceNo Int @map("sequence_no")
  plannedYieldRate Decimal? @map("planned_yield_rate") @db.Decimal(5, 4) /// 열연은 null (규격 매핑에서 계산)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([itemType, sequenceNo])
  @@unique([itemType, processType])
  @@map("routing")
}

/// / 부분 unique (마이그레이션 SQL) / - (raw_material_item_id) WHERE steel_grade_id IS NULL / - (raw_material_item_id, steel_grade_id) WHERE steel_grade_id IS NOT NULL / service: steel_grade_id는 FERROALLOY 원료에만 허용 /
model SpecificConsumption {
  id Int @id @default(autoincrement())
  rawMaterialItemId Int @map("raw_material_item_id")
  steelGradeId Int? @map("steel_grade_id") /// null = 공통 원단위(용선 톤당 t/t), 값 있음 = 합금철(용강 톤당 kg/t)
  consumptionRate Decimal @map("consumption_rate") @db.Decimal(12, 4)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  rawMaterialItem Item @relation("SpecificConsumptionRawMaterialItem", fields: [rawMaterialItemId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  steelGrade SteelGrade? @relation("SpecificConsumptionSteelGrade", fields: [steelGradeId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([rawMaterialItemId])
  @@index([steelGradeId])
  @@map("specific_consumption")
}

model Customer {
  id Int @id @default(autoincrement())
  customerCode String @unique @map("customer_code") @db.VarChar
  customerName String @map("customer_name") @db.VarChar
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  salesOrders SalesOrder[] @relation("SalesOrderCustomer")
  shipmentRequests ShipmentRequest[] @relation("ShipmentRequestCustomer")

  @@map("customer")
}

model Supplier {
  id Int @id @default(autoincrement())
  supplierCode String @unique @map("supplier_code") @db.VarChar
  supplierName String @map("supplier_name") @db.VarChar
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  itemsAsDefaultSupplier Item[] @relation("ItemDefaultSupplier")
  purchaseOrders PurchaseOrder[] @relation("PurchaseOrderSupplier")

  @@map("supplier")
}

model Yard {
  id Int @id @default(autoincrement())
  yardCode String @unique @map("yard_code") @db.VarChar
  yardName String @map("yard_name") @db.VarChar
  yardType String @map("yard_type") @db.VarChar /// YARD_TYPE
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  itemsAsDefaultYard Item[] @relation("ItemDefaultYard")
  lots Lot[] @relation("LotYard")

  @@map("yard")
}

/// 1행만 둔다
model ProductionSetting {
  id Int @id @default(autoincrement())
  heatCapacityTon Decimal @default(250) @map("heat_capacity_ton") @db.Decimal(12, 3) /// 용강 기준
  deliveryRiskDays Int @default(3) @map("delivery_risk_days") /// 납기 위험 기준일
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("production_setting")
}

// ───────────────────────────── 수주·재고·예약·배정·출하 (SO, INV, SHP) ─────────────────────────────

/// 헤더 상태는 저장하지 않고 품목 상태로 계산
model SalesOrder {
  id Int @id @default(autoincrement())
  salesOrderNo String @unique @map("sales_order_no") @db.VarChar /// SO-YYMM-NNN
  customerId Int @map("customer_id")
  ownerEmployeeId Int @map("owner_employee_id") /// 담당 영업
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer Customer @relation("SalesOrderCustomer", fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ownerEmployee Employee @relation("SalesOrderOwnerEmployee", fields: [ownerEmployeeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  salesOrderItems SalesOrderItem[] @relation("SalesOrderItemSalesOrder")
  millSheets MillSheet[] @relation("MillSheetSalesOrder")
  businessEvents BusinessEvent[] @relation("BusinessEventSalesOrder")
  chatRooms ChatRoom[] @relation("ChatRoomSalesOrder")

  @@index([customerId])
  @@index([ownerEmployeeId])
  @@map("sales_order")
}

/// CHECK ordered_qty >= 1
model SalesOrderItem {
  id Int @id @default(autoincrement())
  salesOrderId Int @map("sales_order_id")
  itemId Int @map("item_id") /// 슬래브·코일 규격
  orderedQty Int @map("ordered_qty") /// 1 이상 정수. 톤은 저장하지 않음
  dueDate DateTime @map("due_date") @db.Date /// 품목 납기
  salesOrderItemStatus String @default("OPEN") @map("sales_order_item_status") @db.VarChar /// SALES_ORDER_ITEM_STATUS
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  salesOrder SalesOrder @relation("SalesOrderItemSalesOrder", fields: [salesOrderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  item Item @relation("SalesOrderItemItem", fields: [itemId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reservations Reservation[] @relation("ReservationSalesOrderItem")
  shipmentRequestItems ShipmentRequestItem[] @relation("ShipmentRequestItemSalesOrderItem")
  productionPlans ProductionPlan[] @relation("ProductionPlanSalesOrderItem")

  @@index([salesOrderId])
  @@index([itemId])
  @@map("sales_order_item")
}

/// / 예약 조건부 UPDATE (컨벤션 8장) / UPDATE inventory SET reserved_qty = reserved_qty + :n / WHERE id = :id AND on_hand_qty - reserved_qty - rolling_allocated_qty >= :n / 권장 CHECK: on_hand_qty - reserved_qty - rolling_allocated_qty >= 0 /
model Inventory {
  id Int @id @default(autoincrement())
  itemId Int @unique @map("item_id") /// 제품(슬래브·코일)만. 원료 재고는 LOT 잔량 합계
  onHandQty Int @default(0) @map("on_hand_qty") /// 적격·미소진·미출고 매수
  reservedQty Int @default(0) @map("reserved_qty") /// ACTIVE 예약 합계
  rollingAllocatedQty Int @default(0) @map("rolling_allocated_qty") /// 열연 CONFIRMED 배정 합계
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  item Item @relation("InventoryItem", fields: [itemId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("inventory")
}

/// / CHECK reserved_qty >= 1, reservation_status CHECK 권장 / 부분 출고 시 분할: ACTIVE 10 -> ACTIVE 6 + CONVERTED 4 /
model Reservation {
  id Int @id @default(autoincrement())
  salesOrderItemId Int @map("sales_order_item_id")
  itemId Int @map("item_id")
  reservedQty Int @map("reserved_qty")
  reservationStatus String @default("ACTIVE") @map("reservation_status") @db.VarChar /// RESERVATION_STATUS
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  salesOrderItem SalesOrderItem @relation("ReservationSalesOrderItem", fields: [salesOrderItemId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  item Item @relation("ReservationItem", fields: [itemId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([salesOrderItemId])
  @@index([itemId])
  @@map("reservation")
}

/// / 부분 unique: (lot_id) WHERE allocation_status = 'CONFIRMED'  (LOT당 CONFIRMED 1건) / CHECK: SHIPMENT면 shipment_request_item_id만, HOT_ROLLING이면 production_plan_id만 값 있음 / 추천은 저장하지 않음 (작업 로그 ALLOCATION_RECOMMENDED) /
model Allocation {
  id Int @id @default(autoincrement())
  lotId Int @map("lot_id")
  allocationPurpose String @map("allocation_purpose") @db.VarChar /// ALLOCATION_PURPOSE: SHIPMENT, HOT_ROLLING
  shipmentRequestItemId Int? @map("shipment_request_item_id") /// SHIPMENT만
  productionPlanId Int? @map("production_plan_id") /// HOT_ROLLING만
  allocationStatus String @default("CONFIRMED") @map("allocation_status") @db.VarChar /// ALLOCATION_STATUS
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  lot Lot @relation("AllocationLot", fields: [lotId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  shipmentRequestItem ShipmentRequestItem? @relation("AllocationShipmentRequestItem", fields: [shipmentRequestItemId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  productionPlan ProductionPlan? @relation("AllocationProductionPlan", fields: [productionPlanId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([lotId])
  @@index([shipmentRequestItemId])
  @@index([productionPlanId])
  @@map("allocation")
}

/// 출고 확정(Goods Issue)은 별도 테이블 없이 여기에 기록
model ShipmentRequest {
  id Int @id @default(autoincrement())
  shipmentRequestNo String @unique @map("shipment_request_no") @db.VarChar /// DR-YYMM-NNNN
  customerId Int @map("customer_id") /// 같은 고객사 수주 품목만 묶음
  shipDate DateTime? @map("ship_date") @db.Date /// 출하 예정일
  shipmentRequestStatus String @default("REQUESTED") @map("shipment_request_status") @db.VarChar /// SHIPMENT_REQUEST_STATUS
  issuedAt DateTime? @map("issued_at") @db.Timestamptz(3) /// 출고 확정 시각
  issuedEmployeeId Int? @map("issued_employee_id") /// 출고 확정자
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer Customer @relation("ShipmentRequestCustomer", fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  issuedEmployee Employee? @relation("ShipmentRequestIssuedEmployee", fields: [issuedEmployeeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  shipmentRequestItems ShipmentRequestItem[] @relation("ShipmentRequestItemShipmentRequest")
  millSheets MillSheet[] @relation("MillSheetShipmentRequest")

  @@index([customerId])
  @@index([issuedEmployeeId])
  @@map("shipment_request")
}

/// 미배정 매수 = request_qty - 이 품목의 CONFIRMED 배정 수 (0보다 크면 배정 대기)
model ShipmentRequestItem {
  id Int @id @default(autoincrement())
  shipmentRequestId Int @map("shipment_request_id")
  salesOrderItemId Int @map("sales_order_item_id")
  requestQty Int @map("request_qty")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  allocations Allocation[] @relation("AllocationShipmentRequestItem")
  shipmentRequest ShipmentRequest @relation("ShipmentRequestItemShipmentRequest", fields: [shipmentRequestId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  salesOrderItem SalesOrderItem @relation("ShipmentRequestItemSalesOrderItem", fields: [salesOrderItemId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([shipmentRequestId, salesOrderItemId])
  @@index([salesOrderItemId])
  @@map("shipment_request_item")
}

/// LOT 연결 테이블 없음: shipment_request -> shipment_request_item -> allocation(CONSUMED) -> lot
model MillSheet {
  id Int @id @default(autoincrement())
  millSheetNo String @unique @map("mill_sheet_no") @db.VarChar /// MS-{출하요청 일련}-N
  shipmentRequestId Int @map("shipment_request_id")
  salesOrderId Int @map("sales_order_id")
  snapshot Json @db.JsonB /// 발행 시점 고객사·수주·규격·LOT·히트·이론중량·검사값
  pdfPath String? @map("pdf_path") @db.VarChar /// Storage 경로. PDF 버튼 클릭 시 생성
  issuedAt DateTime @map("issued_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  shipmentRequest ShipmentRequest @relation("MillSheetShipmentRequest", fields: [shipmentRequestId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  salesOrder SalesOrder @relation("MillSheetSalesOrder", fields: [salesOrderId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([shipmentRequestId, salesOrderId])
  @@index([salesOrderId])
  @@map("mill_sheet")
}

// ───────────────────────────── 생산·LOT·품질 (PRD, LOT, QC) ─────────────────────────────

/// MRP 소요량은 저장하지 않음 (GET /mrp/requirements 계산 조회)
model ProductionPlan {
  id Int @id @default(autoincrement())
  productionPlanNo String @unique @map("production_plan_no") @db.VarChar /// PP-YYMM-NNNN
  salesOrderItemId Int? @map("sales_order_item_id") /// 수주 취소 시 null로 해제 -> 산출물은 여재
  itemId Int @map("item_id") /// 생산 규격
  shortageQty Int @map("shortage_qty")
  heatCount Int @map("heat_count")
  isReproduction Boolean @default(false) @map("is_reproduction")
  productionPlanStatus String @default("PLANNED") @map("production_plan_status") @db.VarChar /// PRODUCTION_PLAN_STATUS. PLANNED에서만 취소
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  allocations Allocation[] @relation("AllocationProductionPlan")
  salesOrderItem SalesOrderItem? @relation("ProductionPlanSalesOrderItem", fields: [salesOrderItemId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  item Item @relation("ProductionPlanItem", fields: [itemId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  productionResults ProductionResult[] @relation("ProductionResultProductionPlan")
  purchaseRequisitions PurchaseRequisition[] @relation("PurchaseRequisitionProductionPlan")

  @@index([salesOrderItemId])
  @@index([itemId])
  @@map("production_plan")
}

/// CHECK: IRONMAKING이면 blast_furnace_code, STEELMAKING이면 converter_code 필수
model ProductionResult {
  id Int @id @default(autoincrement())
  productionPlanId Int? @map("production_plan_id") /// 제선은 null
  processType String @map("process_type") @db.VarChar /// PROCESS_TYPE
  blastFurnaceCode String? @map("blast_furnace_code") @db.VarChar /// 제선만. 예: BF2
  converterCode String? @map("converter_code") @db.VarChar /// 제강만. 예: BOF1
  startedAt DateTime @map("started_at") @db.Timestamptz(3)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3) /// null이면 작업 중. 제선 원료 투입 기간 = started_at~completed_at
  simulatedLossRate Decimal? @map("simulated_loss_rate") @db.Decimal(5, 4) /// 실적 시뮬레이션만 (0~0.05)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  productionPlan ProductionPlan? @relation("ProductionResultProductionPlan", fields: [productionPlanId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  lots Lot[] @relation("LotProductionResult")

  @@index([productionPlanId])
  @@map("production_result")
}

/// / 합격 여부(is_passed) 컬럼 없음. 판정은 quality_inspection.inspection_result / CHECK remaining_ton >= 0 / CHECK (유형별 필수값) / - RAW_MATERIAL: item_id, goods_receipt_id, remaining_ton / - HOT_METAL: production_result_id, remaining_ton / - HEAT: steel_grade_id, production_result_id / - SLAB·COIL: item_id, production_result_id, produced_date / 여재 = 적격 + AVAILABLE + CONFIRMED 배정 없는 SLAB LOT (저장하지 않음) /
model Lot {
  id Int @id @default(autoincrement())
  lotNo String @unique @map("lot_no") @db.VarChar /// REQ-LOT-003 채번
  lotType String @map("lot_type") @db.VarChar /// LOT_TYPE
  itemId Int? @map("item_id") /// 원료·슬래브·코일
  steelGradeId Int? @map("steel_grade_id") /// 히트
  productionResultId Int? @map("production_result_id") /// 원료 외. 자동 예약 대상은 실적 -> 계획 -> 수주 품목으로 찾음
  goodsReceiptId Int? @unique @map("goods_receipt_id") /// 원료만. 입고 1건 = LOT 1개
  yardId Int? @map("yard_id") /// 원료·슬래브·코일
  lotStatus String @default("AVAILABLE") @map("lot_status") @db.VarChar /// LOT_STATUS
  initialTon Decimal? @map("initial_ton") @db.Decimal(12, 3) /// 원료(입고량)·용선·히트
  remainingTon Decimal? @map("remaining_ton") @db.Decimal(12, 3) /// 원료·용선. 투입 시 차감
  producedDate DateTime? @map("produced_date") @db.Date /// 슬래브·코일 생산완료일. 배정 FIFO 기준
  dispositionStatus String? @map("disposition_status") @db.VarChar /// DISPOSITION_STATUS. 불합격 후 품질 담당이 지정
  dispositionReason String? @map("disposition_reason") @db.VarChar
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  allocations Allocation[] @relation("AllocationLot")
  item Item? @relation("LotItem", fields: [itemId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  steelGrade SteelGrade? @relation("LotSteelGrade", fields: [steelGradeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  productionResult ProductionResult? @relation("LotProductionResult", fields: [productionResultId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  goodsReceipt GoodsReceipt? @relation("LotGoodsReceipt", fields: [goodsReceiptId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  yard Yard? @relation("LotYard", fields: [yardId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  lotRelationsAsParentLot LotRelation[] @relation("LotRelationParentLot")
  lotRelationsAsChildLot LotRelation[] @relation("LotRelationChildLot")
  qualityInspection QualityInspection? @relation("QualityInspectionLot")
  businessEventLots BusinessEventLot[] @relation("BusinessEventLotLot")

  @@index([itemId])
  @@index([steelGradeId])
  @@index([productionResultId])
  @@index([yardId])
  @@map("lot")
}

/// / CHECK parent_lot_id <> child_lot_id / 용선->히트 N:M, 히트->슬래브 1:N, 슬래브->코일 1:1. LOT 번호 파싱으로 계보를 만들지 않음 /
model LotRelation {
  id Int @id @default(autoincrement())
  parentLotId Int @map("parent_lot_id") /// 투입 LOT
  childLotId Int @map("child_lot_id") /// 산출 LOT
  lotRelationEvidence String @map("lot_relation_evidence") @db.VarChar /// LOT_RELATION_EVIDENCE: 원료->용선 PERIOD_BASED, 나머지 ACTUAL_INPUT
  inputTon Decimal? @map("input_ton") @db.Decimal(12, 3) /// 차감량 (원료->용선, 용선->히트, 합금철->히트)
  inputStartedAt DateTime? @map("input_started_at") @db.Timestamptz(3) /// PERIOD_BASED만
  inputEndedAt DateTime? @map("input_ended_at") @db.Timestamptz(3) /// PERIOD_BASED만
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  parentLot Lot @relation("LotRelationParentLot", fields: [parentLotId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  childLot Lot @relation("LotRelationChildLot", fields: [childLotId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([parentLotId, childLotId])
  @@index([childLotId])
  @@map("lot_relation")
}

/// 수정하지 않고 새 버전으로 추가. 제강 기준의 항목이 강종 성분 규격
model InspectionStandard {
  id Int @id @default(autoincrement())
  inspectionStandardCode String @map("inspection_standard_code") @db.VarChar /// 예: QS-SM355A-HR
  versionNo Int @map("version_no")
  processType String @map("process_type") @db.VarChar /// PROCESS_TYPE
  steelGradeId Int @map("steel_grade_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  steelGrade SteelGrade @relation("InspectionStandardSteelGrade", fields: [steelGradeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  inspectionStandardItems InspectionStandardItem[] @relation("InspectionStandardItemInspectionStandard")
  qualityInspections QualityInspection[] @relation("QualityInspectionInspectionStandard")

  @@unique([inspectionStandardCode, versionNo])
  @@index([steelGradeId])
  @@map("inspection_standard")
}

model InspectionStandardItem {
  id Int @id @default(autoincrement())
  inspectionStandardId Int @map("inspection_standard_id")
  inspectionItemCode String @map("inspection_item_code") @db.VarChar /// 예: C, SI, MN, YS, TS, EL, CVN
  inspectionItemName String @map("inspection_item_name") @db.VarChar
  unit String? @db.VarChar
  minValue Decimal? @map("min_value") @db.Decimal(12, 4) /// 이상 (경계 포함)
  maxValue Decimal? @map("max_value") @db.Decimal(12, 4) /// 이하 (경계 포함)
  thicknessOverMm Decimal? @map("thickness_over_mm") @db.Decimal(8, 2) /// 적용 두께 초과
  thicknessUptoMm Decimal? @map("thickness_upto_mm") @db.Decimal(8, 2) /// 적용 두께 이하
  isRequired Boolean @default(true) @map("is_required") /// 누락 시 PENDING
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  inspectionStandard InspectionStandard @relation("InspectionStandardItemInspectionStandard", fields: [inspectionStandardId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  qualityInspectionValues QualityInspectionValue[] @relation("QualityInspectionValueInspectionStandardItem")

  @@index([inspectionStandardId])
  @@map("inspection_standard_item")
}

/// / 적격 계산: 슬래브 = 자기 PASS + 부모 히트 PASS, 코일 = 자기 PASS + 슬래브 경유 히트 PASS / 밀시트 발행 후 측정값 수정 차단 (service) /
model QualityInspection {
  id Int @id @default(autoincrement())
  lotId Int @unique @map("lot_id") /// LOT당 1건
  inspectionStandardId Int @map("inspection_standard_id") /// 판정에 쓴 기준 버전
  inspectionResult String @default("PENDING") @map("inspection_result") @db.VarChar /// INSPECTION_RESULT: PENDING, PASS, FAIL
  inspectorEmployeeId Int @map("inspector_employee_id")
  inspectedAt DateTime @map("inspected_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  lot Lot @relation("QualityInspectionLot", fields: [lotId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  inspectionStandard InspectionStandard @relation("QualityInspectionInspectionStandard", fields: [inspectionStandardId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  inspectorEmployee Employee @relation("QualityInspectionInspectorEmployee", fields: [inspectorEmployeeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  qualityInspectionValues QualityInspectionValue[] @relation("QualityInspectionValueQualityInspection")

  @@index([inspectionStandardId])
  @@index([inspectorEmployeeId])
  @@map("quality_inspection")
}

/// 보완·오타 수정은 같은 행 수정, 변경 전·후는 작업 로그
model QualityInspectionValue {
  id Int @id @default(autoincrement())
  qualityInspectionId Int @map("quality_inspection_id")
  inspectionStandardItemId Int @map("inspection_standard_item_id")
  measuredValue Decimal @map("measured_value") @db.Decimal(12, 4)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  qualityInspection QualityInspection @relation("QualityInspectionValueQualityInspection", fields: [qualityInspectionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  inspectionStandardItem InspectionStandardItem @relation("QualityInspectionValueInspectionStandardItem", fields: [inspectionStandardItemId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([qualityInspectionId, inspectionStandardItemId])
  @@index([inspectionStandardItemId])
  @@map("quality_inspection_value")
}

// ───────────────────────────── 구매 (PUR) ─────────────────────────────

/// / CHECK requested_ton > 0 / service: 승인자 = 요청자 소속 부서의 부서장. 반려 후 수정하면 WAITING_APPROVAL로 재요청 /
model PurchaseRequisition {
  id Int @id @default(autoincrement())
  purchaseRequisitionNo String @unique @map("purchase_requisition_no") @db.VarChar /// PR-YYMM-NNNN
  itemId Int @map("item_id") /// 원료 1품목
  requestedTon Decimal @map("requested_ton") @db.Decimal(12, 3) /// required_ton(MRP 소요량)과 구분
  desiredReceiptDate DateTime @map("desired_receipt_date") @db.Date
  requesterId Int @map("requester_id")
  approverId Int? @map("approver_id") /// 승인·반려한 부서장
  approvedAt DateTime? @map("approved_at") @db.Timestamptz(3)
  rejectReason String? @map("reject_reason") @db.VarChar
  requestReason String? @map("request_reason") @db.VarChar
  productionPlanId Int? @map("production_plan_id") /// 근거 계획. MRP 중복 요청 방지
  actionDraftId Int? @unique @map("action_draft_id") /// Message -> ERP 초안으로 생성된 경우
  purchaseRequisitionStatus String @default("WAITING_APPROVAL") @map("purchase_requisition_status") @db.VarChar /// PURCHASE_REQUISITION_STATUS
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  item Item @relation("PurchaseRequisitionItem", fields: [itemId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  requester Employee @relation("PurchaseRequisitionRequester", fields: [requesterId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  approver Employee? @relation("PurchaseRequisitionApprover", fields: [approverId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  productionPlan ProductionPlan? @relation("PurchaseRequisitionProductionPlan", fields: [productionPlanId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actionDraft ActionDraft? @relation("PurchaseRequisitionActionDraft", fields: [actionDraftId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  purchaseOrderItem PurchaseOrderItem? @relation("PurchaseOrderItemPurchaseRequisition")

  @@index([itemId])
  @@index([requesterId])
  @@index([approverId])
  @@index([productionPlanId])
  @@map("purchase_requisition")
}

model PurchaseOrder {
  id Int @id @default(autoincrement())
  purchaseOrderNo String @unique @map("purchase_order_no") @db.VarChar /// PO-YYMM-NNNN
  supplierId Int @map("supplier_id") /// 공급업체 1곳당 발주 1건
  purchaseOrderStatus String @default("CONFIRMED") @map("purchase_order_status") @db.VarChar /// PURCHASE_ORDER_STATUS
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  supplier Supplier @relation("PurchaseOrderSupplier", fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  purchaseOrderItems PurchaseOrderItem[] @relation("PurchaseOrderItemPurchaseOrder")

  @@index([supplierId])
  @@map("purchase_order")
}

/// / CHECK ordered_ton > 0 / 입고예정 = ordered_ton - 입고 합계 (저장하지 않음) / service: APPROVED 구매요청만, ordered_ton <= requested_ton /
model PurchaseOrderItem {
  id Int @id @default(autoincrement())
  purchaseOrderId Int @map("purchase_order_id")
  purchaseRequisitionId Int @unique @map("purchase_requisition_id") /// 생성 시 구매요청 ORDERED
  itemId Int @map("item_id")
  orderedTon Decimal @map("ordered_ton") @db.Decimal(12, 3)
  expectedReceiptDate DateTime? @map("expected_receipt_date") @db.Date /// MRP 입고예정 필요일 판단용
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  purchaseOrder PurchaseOrder @relation("PurchaseOrderItemPurchaseOrder", fields: [purchaseOrderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  purchaseRequisition PurchaseRequisition @relation("PurchaseOrderItemPurchaseRequisition", fields: [purchaseRequisitionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  item Item @relation("PurchaseOrderItemItem", fields: [itemId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  goodsReceipts GoodsReceipt[] @relation("GoodsReceiptPurchaseOrderItem")

  @@index([purchaseOrderId])
  @@index([itemId])
  @@map("purchase_order_item")
}

/// / CHECK received_ton > 0 / service: 입고 합계 <= ordered_ton (발주 품목 행 잠금). 등록이 곧 확정, 원료 LOT 생성 /
model GoodsReceipt {
  id Int @id @default(autoincrement())
  goodsReceiptNo String @unique @map("goods_receipt_no") @db.VarChar /// GR-YYMM-NNNN
  purchaseOrderItemId Int @map("purchase_order_item_id")
  receivedTon Decimal @map("received_ton") @db.Decimal(12, 3)
  receivedDate DateTime @map("received_date") @db.Date /// 원료 FIFO 기준
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  lot Lot? @relation("LotGoodsReceipt")
  purchaseOrderItem PurchaseOrderItem @relation("GoodsReceiptPurchaseOrderItem", fields: [purchaseOrderItemId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([purchaseOrderItemId])
  @@map("goods_receipt")
}

// ───────────────────────────── 작업 로그·업무·알림·메신저·Action Draft (LOG, NTF, MSG, ACT) ─────────────────────────────

/// 본 거래와 같은 트랜잭션에서 businessEventRecorder.record(tx, ...)로 기록
model BusinessEvent {
  id Int @id @default(autoincrement())
  businessEventNo String @unique @map("business_event_no") @db.VarChar /// EV-YYMMDD-NNN
  businessEventType String @map("business_event_type") @db.VarChar /// BUSINESS_EVENT_TYPE
  actorType String @map("actor_type") @db.VarChar /// ACTOR_TYPE: USER, SYSTEM
  actorEmployeeId Int? @map("actor_employee_id") /// SYSTEM이면 null
  targetType String @map("target_type") @db.VarChar /// 대상 테이블명
  targetId Int @map("target_id")
  salesOrderId Int? @map("sales_order_id") /// 수주 타임라인용
  beforeData Json? @map("before_data") @db.JsonB /// 비밀번호 해시·토큰 저장 금지
  afterData Json? @map("after_data") @db.JsonB
  reason String? @db.VarChar
  isAiAssisted Boolean @default(false) @map("is_ai_assisted")
