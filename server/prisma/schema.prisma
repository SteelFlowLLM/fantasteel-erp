  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3) /// 발생 시각
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  actorEmployee Employee? @relation("BusinessEventActorEmployee", fields: [actorEmployeeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  salesOrder SalesOrder? @relation("BusinessEventSalesOrder", fields: [salesOrderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actionDraft ActionDraft? @relation("BusinessEventActionDraft", fields: [actionDraftId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  message Message? @relation("BusinessEventMessage", fields: [messageId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  businessEventLots BusinessEventLot[] @relation("BusinessEventLotBusinessEvent")
  notifications Notification[] @relation("NotificationBusinessEvent")

  @@index([targetType, targetId])
  @@index([salesOrderId])
  @@index([actorEmployeeId])
