/// / 부분 unique (중복 알림 방지) / - (message_id, recipient_id) WHERE message_id IS NOT NULL / - (business_event_id, recipient_id) WHERE business_event_id IS NOT NULL /
model Notification {
  id Int @id @default(autoincrement())
  notificationType String @map("notification_type") @db.VarChar /// NOTIFICATION_TYPE
  recipientId Int @map("recipient_id") /// 부서 알림은 발송 시 부서원별 행으로 펼침
  notificationContent String @map("notification_content") @db.VarChar
  linkPath String? @map("link_path") @db.VarChar /// ERP 화면 이동 경로
  messageId Int? @map("message_id")
  businessEventId Int? @map("business_event_id")
  readAt DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  recipient Employee @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  message Message? @relation("NotificationMessage", fields: [messageId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  businessEvent BusinessEvent? @relation("NotificationBusinessEvent", fields: [businessEventId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([recipientId])
  @@index([messageId])
  @@index([businessEventId])
  @@map("notification")
}

/// CHECK: WORK면 sales_order_id 필수
model ChatRoom {
  id Int @id @default(autoincrement())
  chatRoomType String @map("chat_room_type") @db.VarChar /// CHAT_ROOM_TYPE: DIRECT, GROUP, WORK
  chatRoomName String? @map("chat_room_name") @db.VarChar
  salesOrderId Int? @map("sales_order_id") /// 업무방만
  pinnedMessageId Int? @map("pinned_message_id") /// 방 위에 고정한 공지 메시지 (스키마 2차)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  salesOrder SalesOrder? @relation("ChatRoomSalesOrder", fields: [salesOrderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  pinnedMessage Message? @relation("ChatRoomPinnedMessage", fields: [pinnedMessageId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  chatRoomMembers ChatRoomMember[] @relation("ChatRoomMemberChatRoom")
  messages Message[] @relation("MessageChatRoom")

  @@index([salesOrderId])
  @@map("chat_room")
}

model ChatRoomMember {
  id Int @id @default(autoincrement())
  chatRoomId Int @map("chat_room_id")
  employeeId Int @map("employee_id")
  lastReadMessageId Int? @map("last_read_message_id") /// 안 읽은 수 계산 기준
  muted Boolean @default(false) /// 이 방 알림 끄기 (스키마 2차)
  pinnedAt DateTime? @map("pinned_at") @db.Timestamptz(3) /// 내 목록 위에 고정한 시각. null이면 고정 안 함 (스키마 2차)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  chatRoom ChatRoom @relation("ChatRoomMemberChatRoom", fields: [chatRoomId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  employee Employee @relation("ChatRoomMemberEmployee", fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  lastReadMessage Message? @relation("ChatRoomMemberLastReadMessage", fields: [lastReadMessageId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([chatRoomId, employeeId])
  @@index([employeeId])
  @@index([lastReadMessageId])
  @@map("chat_room_member")
}

/// CHECK message_type = 'USER' → sender_id IS NOT NULL / CHECK message_type = 'SYSTEM' → sender_id IS NULL / 부분 unique (sender_id, client_message_id) WHERE client_message_id IS NOT NULL
model Message {
  id Int @id @default(autoincrement())
  chatRoomId Int @map("chat_room_id")
  messageType String @default("USER") @map("message_type") @db.VarChar /// MESSAGE_TYPE: USER, SYSTEM
  senderId Int? @map("sender_id") /// SYSTEM이면 null
  content String?
  clientMessageId String? @map("client_message_id") @db.VarChar(64) /// 화면이 만든 보내기 id(UUID). 재전송 중복 방지
  parentMessageId Int? @map("parent_message_id") /// 답글 대상. 같은 방 메시지만(service)
  editedAt DateTime? @map("edited_at") @db.Timestamptz(3) /// 본문을 마지막으로 고친 시각
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3) /// 삭제 표시. 행은 지우지 않음
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3) /// 발송 시각
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  businessEvents BusinessEvent[] @relation("BusinessEventMessage")
  notifications Notification[] @relation("NotificationMessage")
  chatRoomMembersAsLastReadMessage ChatRoomMember[] @relation("ChatRoomMemberLastReadMessage")
  chatRoomsAsPinnedMessage ChatRoom[] @relation("ChatRoomPinnedMessage")
  tasks Task[] @relation("TaskMessage")
  messageReactions MessageReaction[] @relation("MessageReactionMessage")
  messageAttachments MessageAttachment[] @relation("MessageAttachmentMessage")
  chatRoom ChatRoom @relation("MessageChatRoom", fields: [chatRoomId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sender Employee? @relation("MessageSender", fields: [senderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  parentMessage Message? @relation("MessageParentMessage", fields: [parentMessageId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  messagesAsParentMessage Message[] @relation("MessageParentMessage")
  actionDrafts ActionDraft[] @relation("ActionDraftMessage")

  @@index([chatRoomId, id])
  @@index([senderId])
  @@index([parentMessageId])
  @@map("message")
}

/// 이모지 반응 (스키마 2차). 한 사람이 한 메시지에 같은 이모지는 한 번
model MessageReaction {
  id Int @id @default(autoincrement())
  messageId Int @map("message_id")
  employeeId Int @map("employee_id")
  emoji String @db.VarChar(16) /// 허용 목록은 shared MESSAGE_REACTION_EMOJIS (스키마 2차)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  message Message @relation("MessageReactionMessage", fields: [messageId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  employee Employee @relation("MessageReactionEmployee", fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([messageId, employeeId, emoji])
  @@index([employeeId])
  @@map("message_reaction")
}

/// 메시지 첨부 파일 (스키마 3차). 메시지 1건에 여러 개, sort_order 순으로 보인다
model MessageAttachment {
  id Int @id @default(autoincrement())
  messageId Int @map("message_id")
  filePath String @map("file_path") @db.VarChar /// Storage 경로
  fileName String @map("file_name") @db.VarChar
  fileSize Int? @map("file_size") /// 바이트. 스키마 3차 전에 올린 첨부는 null
  sortOrder Int @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  message Message @relation("MessageAttachmentMessage", fields: [messageId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([messageId, sortOrder])
  @@map("message_attachment")
}

/// / 부분 unique: (message_id, action_type) /   WHERE draft_status IN ('AI_GENERATED', 'WAITING_APPROVAL', 'APPROVED')  (미처리 초안 중복 방지) / 결과는 생성된 업무 테이블의 action_draft_id로 연결 (purchase_requisition.action_draft_id) /
model ActionDraft {
  id Int @id @default(autoincrement())
  actionType String @map("action_type") @db.VarChar /// ACTION_TYPE. P1은 PURCHASE_REQUISITION_CREATE
  draftStatus String @default("AI_GENERATED") @map("draft_status") @db.VarChar /// DRAFT_STATUS
  payload Json @db.JsonB /// 추출 스키마 값
  messageId Int? @map("message_id") /// 추출 원본
  requesterId Int? @map("requester_id") /// 확정 주체. 구매요청 초안은 메시지 작성자
  confirmedAt DateTime? @map("confirmed_at") @db.Timestamptz(3)
  rejectReason String? @map("reject_reason") @db.VarChar
  executionErrorCode String? @map("execution_error_code") @db.VarChar /// 핸들러 실행 실패. 상태는 추가하지 않음
  executionAttemptCount Int @default(0) @map("execution_attempt_count")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  purchaseRequisition PurchaseRequisition? @relation("PurchaseRequisitionActionDraft")
  businessEvents BusinessEvent[] @relation("BusinessEventActionDraft")
  message Message? @relation("ActionDraftMessage", fields: [messageId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  requester Employee? @relation("ActionDraftRequester", fields: [requesterId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([messageId])
  @@index([requesterId])
  @@map("action_draft")
}
