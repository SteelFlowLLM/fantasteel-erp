{
  "compilerOptions": {
    "module": "commonjs", "moduleResolution": "node10", "target": "ES2022", "lib": ["ES2023"],
    "declaration": false, "removeComments": true, "emitDecoratorMetadata": true, "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true, "esModuleInterop": true, "sourceMap": true, "outDir": "./dist", "rootDir": "./src",
    "incremental": true, "skipLibCheck": true, "strict": true, "strictPropertyInitialization": false,
    "forceConsistentCasingInFileNames": true, "resolveJsonModule": true
  },
  "include": ["src/**/*"], "exclude": ["node_modules", "dist"]
}
