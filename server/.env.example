# 로컬: npm run db 로 띄운 PostgreSQL (포트는 로컬 Supabase와 같음)
# 공용 Supabase(SERVER-GUIDE 8장): DATABASE_URL = Transaction pooler(6543) + ?pgbouncer=true, DIRECT_URL = Session pooler(5432)
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/fantasteel
DIRECT_URL=postgresql://postgres:postgres@localhost:54322/fantasteel
# 운영은 NODE_ENV=production으로 띄운다. 그때 JWT_SECRET·DATABASE_URL·CORS_ORIGIN이 없거나 JWT_SECRET이 아래 로컬 값이면 서버가 뜨지 않는다
JWT_SECRET=change-me-local-only
JWT_EXPIRES_IN=12h
API_PORT=8787
STORAGE_DIR=./storage
# 쿠키를 주고받을 프론트 주소 (쉼표로 여러 개)
CORS_ORIGIN=http://localhost:5173
# 시드 사원 비밀번호 (로컬·시연용)
SEED_PASSWORD=fantasteel
# LLM 연결 기본값 (화면 '관리 > AI 연결'에서 저장하면 STORAGE_DIR/settings/llm.json 값이 우선)
# LM Studio 로컬 서버(LM Link로 다른 컴퓨터 모델을 쓸 때도 같은 주소). 외부 LLM은 주소와 API 키를 넣는다
LLM_BASE_URL=http://127.0.0.1:1234/v1
LLM_MODEL=
LLM_API_KEY=
# 외부 서비스 연결(Notion MCP 등, 관리 > 외부 연결)의 토큰을 DB에 암호화해 두는 키. 32바이트를 base64나 64자리 16진수로
#   만들기: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 비우면 서버는 뜨고 연결 기능만 막힌다. 바꾸면 저장된 연결을 풀 수 없어 관리자가 다시 연결해야 한다
INTEGRATION_SECRET_KEY=
# 브라우저가 이 서버에 닿는 주소. OAuth redirect URI(<주소>/integrations/oauth/callback)가 된다
SERVER_PUBLIC_URL=http://localhost:8787/api/v1
# OAuth를 마치고 돌아갈 화면 주소 (비우면 CORS_ORIGIN의 첫 주소)
CLIENT_BASE_URL=
# Notion 원격 MCP 서버 주소 (비우면 https://mcp.notion.com/mcp)
NOTION_MCP_URL=
# Google Drive는 관리 > 외부 연결 화면에서 관리자가 OAuth client id·secret과 폴더를 넣는다 (환경변수 없음, docs/backend/integration.md).
# 테스트 전용 GOOGLE_API_TEST_ORIGIN(가짜 Google 서버 주소)은 운영(NODE_ENV=production)에서 무시하며 여기에 넣지 않는다.
# 철강맨AI 장소 검색(search_places, 이슈 #367). 카카오 키가 있으면 카카오, 없으면 아래 네이버 키로 찾는다. 둘 다 비우면 장소 검색 도구를 모델에 알리지 않는다(웹 검색·페이지 읽기는 키 없이 된다)
# 받는 법: developers.kakao.com → 내 애플리케이션 → 애플리케이션 추가(앱 만들기) → 앱 키의 'REST API 키'.
# 같은 앱의 '카카오맵' 사용 설정을 ON으로 켜야 한다(끄면 401 OPEN_MAP_AND_LOCAL). 서버에서만 쓰고 화면에 보내지 않는다
KAKAO_REST_API_KEY=
# 철강맨AI 웹 검색 1순위 — 네이버 검색 API(공식·무료, 이슈 #367). 비우면 DuckDuckGo(비공식, 자주 막힘) → 위키백과로만 찾는다.
# 받는 법: developers.naver.com → Application → 애플리케이션 등록 → 사용 API에 '검색' 추가 → Client ID·Client Secret.
# 하루 호출 한도 25,000회(검색 API 합산, 2026-10 문서 기준). '검색'을 빼면 403, 키가 틀리면 401, 한도를 넘으면 429 → 다음 검색 방법으로 넘어간다.
# 카카오 키가 없으면 장소 검색도 네이버 지역 검색(한 번에 5곳)으로 한다. 서버에서만 쓰고 화면에 보내지 않는다
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 철강맨AI 웹 페이지 읽기에서 막을 호스트(쉼표 목록, 그 이름과 하위 도메인. 예: intranet.example.com,corp.example).
# 사내망 IP는 늘 막는다. 공용 주소로 열린 사내 서비스가 있으면 여기에 적는다. 위의 SERVER_PUBLIC_URL·CLIENT_BASE_URL과 CORS_ORIGIN의 호스트(이 서버·화면 자신)도 늘 막는다
WEB_FETCH_DENY_HOSTS=
