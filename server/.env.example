# 로컬: npm run db 로 띄운 PostgreSQL (포트는 로컬 Supabase와 같음)
# 공용 Supabase(SERVER-GUIDE 8장): DATABASE_URL = Transaction pooler(6543) + ?pgbouncer=true, DIRECT_URL = Session pooler(5432)
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/fantasteel
DIRECT_URL=postgresql://postgres:postgres@localhost:54322/fantasteel
# 운영은 NODE_ENV=production으로 띄운다. 그때 JWT_SECRET·DATABASE_URL·CORS_ORIGIN이 없거나 JWT_SECRET이 아래 로컬 값이면 서버가 뜨지 않는다
JWT_SECRET=change-me-local-only
JWT_EXPIRES_IN=12h
API_PORT=8787
STORAGE_DIR=./storage
# 쿠키를 주고받을 프론트 주소 (쉼표로 여러 개)
CORS_ORIGIN=http://localhost:5173
# 시드 사원 비밀번호 (로컬·시연용)
SEED_PASSWORD=fantasteel
# LLM 연결 기본값 (화면 '관리 > AI 연결'에서 저장하면 STORAGE_DIR/settings/llm.json 값이 우선)
# LM Studio 로컬 서버(LM Link로 다른 컴퓨터 모델을 쓸 때도 같은 주소). 외부 LLM은 주소와 API 키를 넣는다
LLM_BASE_URL=http://127.0.0.1:1234/v1
LLM_MODEL=
LLM_API_KEY=
# 철강맨AI 장소 검색(search_places, 이슈 #367). 비우면 장소 검색 도구를 모델에 알리지 않는다(웹 검색·페이지 읽기는 키 없이 된다)
# 받는 법: developers.kakao.com → 내 애플리케이션 → 애플리케이션 추가(앱 만들기) → 앱 키의 'REST API 키'.
# 같은 앱의 '카카오맵' 사용 설정을 ON으로 켜야 한다(끄면 401 OPEN_MAP_AND_LOCAL). 서버에서만 쓰고 화면에 보내지 않는다
KAKAO_REST_API_KEY=
