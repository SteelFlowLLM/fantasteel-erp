# 로컬: npm run db 로 띄운 PostgreSQL (포트는 로컬 Supabase와 같음)
# 공용 Supabase(SERVER-GUIDE 8장): DATABASE_URL = Transaction pooler(6543) + ?pgbouncer=true, DIRECT_URL = Session pooler(5432)
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/fantasteel
DIRECT_URL=postgresql://postgres:postgres@localhost:54322/fantasteel
# 운영은 NODE_ENV=production으로 띄운다. 그때 JWT_SECRET·DATABASE_URL·CORS_ORIGIN이 없거나 JWT_SECRET이 아래 로컬 값이면 서버가 뜨지 않는다
JWT_SECRET=change-me-local-only
JWT_EXPIRES_IN=12h
API_PORT=8787
STORAGE_DIR=./storage
# 쿠키를 주고받을 프론트 주소 (쉼표로 여러 개)
CORS_ORIGIN=http://localhost:5173
# 다른 PC가 http://<이 컴퓨터 IP>:5173으로 들어와 로그인하려면 false (http에서는 Secure 쿠키가 저장되지 않는다). 운영(https)에서는 넣지 않는다
# COOKIE_SECURE=false
# 시드 사원 비밀번호 (로컬·시연용)
SEED_PASSWORD=fantasteel
# LLM 연결 기본값 (화면 '관리 > AI 연결'에서 저장하면 STORAGE_DIR/settings/llm.json 값이 우선)
# LM Studio 로컬 서버(LM Link로 다른 컴퓨터 모델을 쓸 때도 같은 주소). 외부 LLM은 주소와 API 키를 넣는다
LLM_BASE_URL=http://127.0.0.1:1234/v1
LLM_MODEL=
LLM_API_KEY=
# Message → ERP 초안의 AI 추출 제한 시간(초, 1~600). 넘기면 빈 초안으로 만든다. 기본 90 (이슈 #472)
# MESSAGE_EXTRACT_TIMEOUT_SECONDS=90
# 외부 서비스 연결(Notion MCP 등, 관리 > 외부 연결)의 토큰을 DB에 암호화해 두는 키. 32바이트를 base64나 64자리 16진수로
#   만들기: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 비우면 서버는 뜨고 연결 기능만 막힌다. 바꾸면 저장된 연결을 풀 수 없어 관리자가 다시 연결해야 한다
INTEGRATION_SECRET_KEY=
# 브라우저가 이 서버에 닿는 주소. OAuth redirect URI(<주소>/integrations/oauth/callback)가 된다
SERVER_PUBLIC_URL=http://localhost:8787/api/v1
# OAuth를 마치고 돌아갈 화면 주소 (비우면 CORS_ORIGIN의 첫 주소)
CLIENT_BASE_URL=
# Notion 원격 MCP 서버 주소 (비우면 https://mcp.notion.com/mcp)
NOTION_MCP_URL=
# Google Drive 연결 (docs/backend/integration.md 11장). 두 방법 가운데 하나:
#   (1) 서비스 계정(권장, 이슈 #395): 아래 키를 넣으면 로그인 없이 연결된다. 서버를 다시 띄우거나 DB를 비우거나 다른 PC에서 띄워도 다시 연결하지 않는다
#   (2) OAuth: 키를 비우면 관리 > 외부 연결 화면에서 관리자가 OAuth client id·secret을 넣고 Google 계정으로 연결한다 (DB에 암호화)
# 서비스 계정 만들기:
#   1. console.cloud.google.com → 프로젝트 고르기(없으면 만들기) → API 및 서비스 → 라이브러리 → Google Drive API → 사용 설정
#   2. IAM 및 관리자 → 서비스 계정 → 서비스 계정 만들기 (역할은 주지 않아도 된다)
#   3. 만든 서비스 계정 → 키 → 키 추가 → 새 키 만들기 → JSON → 내려받은 파일을 server/secrets/ 에 둔다 (git에 올라가지 않는다)
#   4. Drive에서 녹음·사진 폴더 → 공유 → 서비스 계정 메일(…@….iam.gserviceaccount.com, 키 파일의 client_email)을 '뷰어'로 추가
#   5. 아래 값을 넣고 서버를 다시 띄운 뒤 관리 > 외부 연결 > Google Drive에서 '연결 확인'
# 키 파일 경로. 상대 경로는 서버 폴더(server/) 기준. 예: secrets/google-service-account.json
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=
# 파일을 둘 수 없는 곳(배포 환경 변수)이면 키 JSON 자체나 그 base64를 한 줄로 넣는다 (base64 권장: base64 -i key.json | tr -d '\n').
# 둘 다 넣으면 파일을 쓴다. 키는 비밀번호와 같다: 커밋·메신저로 보내지 않는다
GOOGLE_SERVICE_ACCOUNT_KEY=
# 읽을 Drive 폴더 주소나 id (선택). 넣으면 화면에서 저장한 폴더보다 먼저다. 비우면 관리 > 외부 연결 화면의 폴더를 쓴다
GOOGLE_DRIVE_FOLDER=
# 테스트 전용 GOOGLE_API_TEST_ORIGIN(가짜 Google 서버 주소)은 운영(NODE_ENV=production)에서 무시하며 여기에 넣지 않는다.
# 철강맨AI 장소 검색(search_places, 이슈 #367). 카카오 키가 있으면 카카오, 없으면 아래 네이버 키로 찾는다. 둘 다 비우면 장소 검색 도구를 모델에 알리지 않는다(웹 검색·페이지 읽기는 키 없이 된다)
# 받는 법: developers.kakao.com → 내 애플리케이션 → 애플리케이션 추가(앱 만들기) → 앱 키의 'REST API 키'.
# 이 키 하나로 다음 웹 검색(웹 검색 2순위, 네이버 다음)과 장소 검색을 함께 쓴다. 장소 검색은 같은 앱의 '카카오맵' 사용 설정을 ON으로 켜야 한다(끄면 401 OPEN_MAP_AND_LOCAL). 다음 웹 검색은 REST API 키만 있으면 된다. 서버에서만 쓰고 화면에 보내지 않는다
KAKAO_REST_API_KEY=
# 철강맨AI 웹 검색 1순위 — 네이버 검색 API(공식·무료, 이슈 #367). 비우면 DuckDuckGo(비공식, 자주 막힘) → 위키백과로만 찾는다.
# 받는 법: developers.naver.com → Application → 애플리케이션 등록 → 사용 API에 '검색' 추가 → Client ID·Client Secret.
# 하루 호출 한도 25,000회(검색 API 합산, 2026-10 문서 기준). '검색'을 빼면 403, 키가 틀리면 401, 한도를 넘으면 429 → 다음 검색 방법으로 넘어간다.
# 카카오 키가 없으면 장소 검색도 네이버 지역 검색(한 번에 5곳)으로 한다. 서버에서만 쓰고 화면에 보내지 않는다
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 철강맨AI 웹 페이지 읽기에서 막을 호스트(쉼표 목록, 그 이름과 하위 도메인. 예: intranet.example.com,corp.example).
# 사내망 IP는 늘 막는다. 공용 주소로 열린 사내 서비스가 있으면 여기에 적는다. 위의 SERVER_PUBLIC_URL·CLIENT_BASE_URL과 CORS_ORIGIN의 호스트(이 서버·화면 자신)도 늘 막는다
WEB_FETCH_DENY_HOSTS=
# 철강맨AI 브라우저 사용(이슈 #373). true일 때만 패널의 '브라우저' 켜기로 AI가 바깥 웹페이지를 열고 누르고 입력한다(기본 꺼짐).
# 설치된 Google Chrome을 쓰고 브라우저를 내려받지 않는다. 막을 호스트·사내망 막기는 위 웹 페이지 읽기와 같다
AI_BROWSER_ENABLED=false
# Chrome이 기본 위치(macOS /Applications/Google Chrome.app, Linux /opt/google/chrome/chrome, Windows Program Files)에 없으면 실행 파일 경로
BROWSER_EXECUTABLE_PATH=
# Chrome 샌드박스는 늘 켠다. 샌드박스가 뜨지 않는 Linux 서버(root·일부 컨테이너)에서만 true로 끈다(그만큼 위험해진다)
BROWSER_NO_SANDBOX=false
# false면 서버 컴퓨터 화면에 Chrome 창을 띄워 AI가 움직이는 것을 그대로 본다(개발·시연용, 이슈 #423). 다른 사원 PC에는 보이지 않는다. 기본은 창 없이(true)
BROWSER_HEADLESS=true
# 링크 없이 브라우저로 열 수 있는 시작 사이트(쉼표로 나눈 호스트, 하위 호스트 포함, 이슈 #423). 비워 두면 없음, 줄이 없으면 기본 목록
# 기본: naver.com,daum.net,wikipedia.org,namu.wiki,go.kr,kosis.kr,kosa.or.kr,worldsteel.org,kita.net
# BROWSER_START_SITES=
# 관리자가 AI 연결 화면에서 시작 사이트 목록을 저장하면 이 값보다 그 목록을 먼저 쓴다. 같은 화면의 '모든 사이트 열기' 스위치(기본 꺼짐)를 켜면 목록 밖 주소도 연다(사내 주소·로그인·결제 막기는 그대로)
# 한 답에서 세는 브라우저 동작 수 상한(이슈 #430, 기본 40, 1~200). 화면 읽기(browser_snapshot)와 실패한 동작은 세지 않고, 같은 동작을 연달아 3번 되풀이하면 막는다
# BROWSER_MAX_ACTIONS=40
# 한 답에서 브라우저를 쓰는 시간(분, 기본 10, 1~60). 사용자가 멈춘 동안은 세지 않는다
# BROWSER_TIME_LIMIT_MINUTES=10
# 사진을 보는 모델이면 브라우저 동작 뒤 화면 사진(요소마다 노란 [r번호] 표)을 모델에 함께 보낸다(이슈 #427, 기본 켬). false면 화면 글만 보낸다.
# 문맥을 아끼려고 가장 최근 사진 한 장만 남긴다. 사진은 저장하지 않는다
BROWSER_VISION=true
# 철강맨AI ERP 화면 조작(이슈 #382, 시험 중). true일 때만 패널에 '화면 조작' 칩이 보이고, AI가 사용자의 화면을 읽고 옮기고 칸을 채운다(기본 꺼짐).
# 동작은 사용자의 브라우저가 하고, 저장·등록·확정 같은 버튼은 누르지 않는다
AI_SCREEN_CONTROL_ENABLED=false
# 철강맨AI 심층 조사 예산(이슈 #384). 비우면 기본값, 상한을 넘으면 상한으로 둔다
#   AI_RESEARCH_MAX_STEPS 새 조사의 단계(검색·읽기) 수, 기본 12·상한 30 (더 조사하기는 +4씩 min(30, 이 값×2)까지)
#   AI_RESEARCH_MAX_SOURCES 모을 출처 수, 기본 40·상한 100
#   AI_RESEARCH_PROMPT_CHARS LLM 요청 한 번의 글자 수 상한, 기본 24000·상한 400000. LM Studio가 모델의 문맥 길이(Context Length)를 알려 주면
#     서버가 그 70%(출력 16384토큰을 남기고)×2자로 정하고 이 값은 상한으로만 쓴다. 더 넣으려면 LM Studio에서 Context Length를 늘려 로드한다
#   AI_RESEARCH_EVIDENCE_SOURCES 다음 행동을 고를 때 보이는 최근 단계 기록(검색어+결과, 읽은 본문) 수, 기본 6·상한 30
#   AI_RESEARCH_REPORT_SOURCES 점검·보고서·차트에 보이는 단계 기록 수, 기본 모두(100, 글자 수 안에서 똑같이 나눈다)
#   AI_RESEARCH_REPORT_TIMEOUT_MINUTES 보고서 LLM 한 번의 시간 제한(분), 기본 10·1~60. 넘으면(또는 연결 실패·모델 없음) 30초·60초 쉬고 최대 2번 더 부탁하고, 그래도 안 되면 조사 메모로 대체본을 남긴다(이슈 #521)
AI_RESEARCH_MAX_STEPS=
AI_RESEARCH_MAX_SOURCES=
AI_RESEARCH_PROMPT_CHARS=
AI_RESEARCH_EVIDENCE_SOURCES=
AI_RESEARCH_REPORT_SOURCES=
AI_RESEARCH_REPORT_TIMEOUT_MINUTES=
# 회의록 AI 정리 한 건의 전체 시간 상한(분, 기본 120, 10~600). 긴 전사는 조각마다 LLM을 불러 오래 걸리고 분석은 한 번에 하나씩 줄을 서므로
# 넘으면 1차 분석 중이면 실패, 2차 검토 중이면 남은 조각 검토를 건너뛰고 마친다
MEETING_ANALYSIS_MAX_MINUTES=
