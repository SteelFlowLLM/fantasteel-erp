# ── 개인 설정 (팀과 공유하지 않음) ─────────────────────
# Claude Code: 팀 공통은 CLAUDE.template.md(초안)·.claude/settings.json, 각자의 CLAUDE.md는 올리지 않는다
CLAUDE.md
.claude/settings.local.json
.claude/*.local.*
# oh-my-claudecode 세션 파일
.omc/
# 편집기
.vscode/*
!.vscode/extensions.json
.idea/

# ── 비밀값 ────────────────────────────────────────────
.env
.env.*
!.env.example
# 배포 폴더의 실제 환경 파일 (deploy/aws/server.env.example 같은 예시 파일은 올린다)
deploy/**/*.env
deploy/**/*.env.local
# Google 서비스 계정 키 등 비밀 파일 (server/.env.example의 GOOGLE_SERVICE_ACCOUNT_KEY_FILE)
server/secrets/

# ── 의존성·빌드 결과 ─────────────────────────────────
node_modules
dist
.next
.vite
client/next-env.d.ts
*.tsbuildinfo
server/src/generated

# ── 로컬 실행 데이터 ─────────────────────────────────
.local-db
.local-db-pg17
server/storage
.run
coverage
*.log

# ── OS ───────────────────────────────────────────────
.DS_Store
Thumbs.db

# Python (tools/voice-sidecar)
__pycache__/
