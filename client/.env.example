# 화면 데이터 출처. 비우거나 mock이면 브라우저 안 가짜 DB(기본). server면 수주·출하·배정·대시보드 영업 위젯, 품질(검사 입력·검사 기준·불합격 관리), 생산(생산계획·작업 실적·열연 투입), 구매(구매요청·승인·발주·입고·MRP와 대시보드 구매 위젯), 출고 확정이 실제 서버를 부른다.
# 이 파일을 client/.env.local로 복사해서 쓴다 (.env.local은 커밋하지 않는다). 바꾼 뒤에는 화면 서버(next dev)를 다시 띄운다.
NEXT_PUBLIC_DATA_SOURCE=mock
# 서버 주소 (server/.env의 API_PORT)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8787/api/v1
# 서버 모드 자동 로그인 비밀번호 = 서버 시드 비밀번호 (docs/backend/seed.md). 로그인 화면이 생기면 쓰지 않는다
NEXT_PUBLIC_DEV_LOGIN_PASSWORD=fantasteel
