// 철강 제조 AI 협업 ERP · P1 ERD (DBML)
// 기준: 설계 문서 "철강 제조 ERP · ERD (P1)" 2026-10-02
// dbdiagram.io에 그대로 붙여넣어 사용

Project steel_erp_p1 {
  database_type: 'PostgreSQL'
  Note: '''
# 철강 제조 ERP P1 ERD (42 테이블)

## 공통 규칙 (코드 컨벤션 7-2)
- 모든 테이블: id autoincrement PK, created_at·updated_at timestamptz(3)
- DB FK 제약 없음 (Prisma relationMode = "prisma"). 아래 ref는 Prisma 관계이며 FK 컬럼마다 인덱스
- 업무번호(*_no)·코드(*_code)는 PK와 별도 unique
- 톤 decimal(12,3), 매수 int, 날짜 date, 시각 timestamptz
- 공통코드 값은 varchar, 컬럼명 = 코드 그룹 ID 소문자. Prisma enum 미사용
- 부분 unique·CHECK는 마이그레이션 SQL로 추가 (각 테이블 Note)

## 설계 결정 (기준 문서와 다르게 정한 것)
- 가용 재고: inventory(on_hand_qty, reserved_qty, rolling_allocated_qty) + 조건부 UPDATE.
  가용 = on_hand_qty - reserved_qty - rolling_allocated_qty
- 구매요청 1건 = 원료 1품목. 발주 품목 1행 = 구매요청 1건
- 합격 여부는 quality_inspection.inspection_result에만 저장. lot.is_passed 없음.
  적격 = 자기 검사 PASS + 상위 히트 검사 PASS (쿼리로 계산)
- 출하 배정은 shipment_request_item에 연결 (reservation_id 없음)
- 납기는 수주 품목 단위 (sales_order_item.due_date)
- 입고예정·입고 누계·여재·수주 헤더 상태·톤·MRP 소요량은 저장하지 않고 계산
- 수주 취소 시 진행 중 계획은 production_plan.sales_order_item_id를 null로 해제 → 산출물은 여재
- 작업 로그 대상 = target_type(테이블명) + target_id, 수주 타임라인용 sales_order_id

## inventory 갱신 규칙 (본 거래와 같은 트랜잭션)
| 이벤트 | on_hand | reserved | rolling | 조건 |
| 수주 등록 예약 | | +n | | 가용 >= n |
| 제품이 적격이 됨 | +1 | | | |
| 자동 예약 | | +1 | | 가용 >= 1 |
| 적격 LOT이 FAIL로 바뀜 | -1 | 초과분 예약 축소 | 배정 있으면 -1 | 배정 RELEASED |
| 열연 배정 확정 | | | +1 | 가용 >= 1 |
| 열연 배정 해제·변경 | | | -1 | |
| 열연 투입 | -1 | | -1 | |
| 출고 확정 | -n | -n | | 예약 CONVERTED 분할 |
| 수주 취소 | | -ACTIVE합계 | | |
조건부 UPDATE에서 바뀐 행이 0이면 INV-001.
불변조건: on_hand_qty = 적격 AVAILABLE LOT 수, reserved_qty = ACTIVE 예약 합계,
rolling_allocated_qty = HOT_ROLLING CONFIRMED 배정 수
'''
}

// =====================================================================
// 1. 조직·권한
// =====================================================================

Table employee {
  id int [pk, increment]
  employee_no varchar [unique, not null, note: '사원번호(로그인 ID)']
  employee_name varchar [not null]
  password_hash varchar [not null, note: 'bcrypt. 응답·로그에 내보내지 않음']
  department_id int [not null, ref: > department.id]
  job_grade_id int [not null, ref: > job_grade.id]
  role_id int [not null, ref: > role.id, note: '사원당 역할 1개']
  is_active boolean [not null, default: true, note: '퇴사 처리. 사원은 삭제하지 않음']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]

  indexes {
    department_id
    job_grade_id
    role_id
  }
}

Table department {
  id int [pk, increment]
  department_code varchar [unique, not null]
  department_name varchar [not null]
  parent_id int [ref: > department.id, note: '상위 부서. 순환 금지(service)']
  head_employee_id int [ref: > employee.id, note: '부서장 1명. 역할이 아님(REQ-ORG-002). 구매요청 최종 승인권자']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]

  indexes {
    parent_id
    head_employee_id
  }
}

Table job_grade {
  id int [pk, increment]
  job_grade_name varchar [not null]
  sort_order int [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]
}

Table role {
  id int [pk, increment]
  role_code varchar [unique, not null, note: 'ROLE: SALES, PURCHASE, PRODUCTION, QUALITY, LOGISTICS, ADMIN']
  role_name varchar [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]
}

Table role_permission {
  id int [pk, increment]
  role_id int [not null, ref: > role.id]
  permission varchar [not null, note: 'PERMISSION']
  permission_level varchar [not null, note: 'PERMISSION_LEVEL: USE, VIEW. 권한이 없으면 행을 두지 않음']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]

  indexes {
    (role_id, permission) [unique]
  }
}

// =====================================================================
// 2. 기준정보
// =====================================================================

Table steel_grade {
  id int [pk, increment]
  steel_grade_code varchar [unique, not null, note: 'STEEL_GRADE: SS275, SM355A~D, SPHC']
  steel_grade_name varchar [not null]
  standard_no varchar [not null, note: 'KS 규격 번호. 밀시트 표시']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]
}

Table item {
  id int [pk, increment]
  item_code varchar [unique, not null, note: '원료 코드(예: ORE01) 또는 규격 코드(예: SL-SS275-250x1500x10000)']
  item_name varchar [not null]
  item_type varchar [not null, note: 'ITEM_TYPE: RAW_MATERIAL, SLAB, COIL']
  unit_type varchar [not null, note: 'UNIT_TYPE: 원료 TON, 제품 QTY']
  raw_material_type varchar [note: 'RAW_MATERIAL_TYPE. 원료만']
  steel_grade_id int [ref: > steel_grade.id, note: '제품만']
  thickness_mm decimal(8,2) [note: '제품만']
  width_mm decimal(8,2) [note: '제품만']
  length_mm decimal(8,2) [note: '제품만']
  theoretical_weight_ton decimal(12,3) [note: '제품만. 두께x폭x길이x7.85/10^9, 소수 3자리 확정값']
  default_yard_id int [not null, ref: > yard.id, note: 'LOT 생성 시 자동 지정']
  default_supplier_id int [ref: > supplier.id, note: '원료만. 품목별 기본 공급업체 1곳']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]

  indexes {
    (item_type, steel_grade_id, thickness_mm, width_mm, length_mm) [unique, note: '제품 규격 중복 금지']
    steel_grade_id
    default_yard_id
    default_supplier_id
  }

  Note: '''
CHECK (마이그레이션 SQL)
- RAW_MATERIAL: unit_type = TON, raw_material_type 필수, 치수·이론중량·steel_grade_id null
- SLAB·COIL: unit_type = QTY, steel_grade_id·치수·theoretical_weight_ton 필수, raw_material_type null
service: 수주·재고·LOT에 사용된 규격은 치수·이론중량 수정 차단(MST-002)
'''
}

Table spec_mapping {
  id int [pk, increment]
  slab_item_id int [unique, not null, ref: - item.id, note: '슬래브 규격']
  coil_item_id int [unique, not null, ref: - item.id, note: '대응 코일 규격 1개']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]

  Note: '''
service: 코일 이론중량 <= 슬래브 1매 이론중량
열연 계획 수율 = 코일 이론중량 / 슬래브 이론중량 (저장하지 않음)
'''
}

Table routing {
  id int [pk, increment]
  item_type varchar [not null, note: 'SLAB 또는 COIL']
  process_type varchar [not null, note: 'PROCESS_TYPE']
  sequence_no int [not null]
  planned_yield_rate decimal(5,4) [note: '열연은 null (규격 매핑에서 계산)']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]

  indexes {
    (item_type, sequence_no) [unique]
    (item_type, process_type) [unique]
  }
}

Table specific_consumption {
  id int [pk, increment]
  raw_material_item_id int [not null, ref: > item.id]
  steel_grade_id int [ref: > steel_grade.id, note: 'null = 공통 원단위(용선 톤당 t/t), 값 있음 = 합금철(용강 톤당 kg/t)']
  consumption_rate decimal(12,4) [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]

  indexes {
    raw_material_item_id
    steel_grade_id
  }

  Note: '''
부분 unique (마이그레이션 SQL)
- (raw_material_item_id) WHERE steel_grade_id IS NULL
- (raw_material_item_id, steel_grade_id) WHERE steel_grade_id IS NOT NULL
service: steel_grade_id는 FERROALLOY 원료에만 허용
'''
}

Table customer {
  id int [pk, increment]
  customer_code varchar [unique, not null]
  customer_name varchar [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]
}

Table supplier {
  id int [pk, increment]
  supplier_code varchar [unique, not null]
  supplier_name varchar [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]
}

Table yard {
  id int [pk, increment]
  yard_code varchar [unique, not null]
  yard_name varchar [not null]
  yard_type varchar [not null, note: 'YARD_TYPE']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]
}

Table production_setting {
  id int [pk, increment]
  heat_capacity_ton decimal(12,3) [not null, default: 250, note: '용강 기준']
  delivery_risk_days int [not null, default: 3, note: '납기 위험 기준일']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]

  Note: '1행만 둔다'
}

// =====================================================================
// 3. 수주·재고·예약·배정·출하
// =====================================================================

Table sales_order {
  id int [pk, increment]
  sales_order_no varchar [unique, not null, note: 'SO-YYMM-NNN']
  customer_id int [not null, ref: > customer.id]
  owner_employee_id int [not null, ref: > employee.id, note: '담당 영업']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]

  indexes {
    customer_id
    owner_employee_id
  }

  Note: '헤더 상태는 저장하지 않고 품목 상태로 계산'
}

Table sales_order_item {
  id int [pk, increment]
  sales_order_id int [not null, ref: > sales_order.id]
  item_id int [not null, ref: > item.id, note: '슬래브·코일 규격']
  ordered_qty int [not null, note: '1 이상 정수. 톤은 저장하지 않음']
  due_date date [not null, note: '품목 납기']
  sales_order_item_status varchar [not null, default: 'OPEN', note: 'SALES_ORDER_ITEM_STATUS']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]

  indexes {
    sales_order_id
    item_id
  }

  Note: 'CHECK ordered_qty >= 1'
}

Table inventory {
  id int [pk, increment]
  item_id int [unique, not null, ref: - item.id, note: '제품(슬래브·코일)만. 원료 재고는 LOT 잔량 합계']
  on_hand_qty int [not null, default: 0, note: '적격·미소진·미출고 매수']
  reserved_qty int [not null, default: 0, note: 'ACTIVE 예약 합계']
  rolling_allocated_qty int [not null, default: 0, note: '열연 CONFIRMED 배정 합계']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]

  Note: '''
예약 조건부 UPDATE (컨벤션 8장)
UPDATE inventory SET reserved_qty = reserved_qty + :n
WHERE id = :id AND on_hand_qty - reserved_qty - rolling_allocated_qty >= :n
권장 CHECK: on_hand_qty - reserved_qty - rolling_allocated_qty >= 0
'''
}

Table reservation {
  id int [pk, increment]
  sales_order_item_id int [not null, ref: > sales_order_item.id]
  item_id int [not null, ref: > item.id]
  reserved_qty int [not null]
  reservation_status varchar [not null, default: 'ACTIVE', note: 'RESERVATION_STATUS']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]

  indexes {
    sales_order_item_id
    item_id
  }

  Note: '''
CHECK reserved_qty >= 1, reservation_status CHECK 권장
부분 출고 시 분할: ACTIVE 10 -> ACTIVE 6 + CONVERTED 4
'''
}

Table allocation {
  id int [pk, increment]
  lot_id int [not null, ref: > lot.id]
  allocation_purpose varchar [not null, note: 'ALLOCATION_PURPOSE: SHIPMENT, HOT_ROLLING']
  shipment_request_item_id int [ref: > shipment_request_item.id, note: 'SHIPMENT만']
  production_plan_id int [ref: > production_plan.id, note: 'HOT_ROLLING만']
  allocation_status varchar [not null, default: 'CONFIRMED', note: 'ALLOCATION_STATUS']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]

  indexes {
    lot_id
    shipment_request_item_id
    production_plan_id
  }

  Note: '''
부분 unique: (lot_id) WHERE allocation_status = 'CONFIRMED'  (LOT당 CONFIRMED 1건)
CHECK: SHIPMENT면 shipment_request_item_id만, HOT_ROLLING이면 production_plan_id만 값 있음
추천은 저장하지 않음 (작업 로그 ALLOCATION_RECOMMENDED)
'''
}

Table shipment_request {
  id int [pk, increment]
  shipment_request_no varchar [unique, not null, note: 'DR-YYMM-NNNN']
  customer_id int [not null, ref: > customer.id, note: '같은 고객사 수주 품목만 묶음']
  ship_date date [note: '출하 예정일']
  shipment_request_status varchar [not null, default: 'REQUESTED', note: 'SHIPMENT_REQUEST_STATUS']
  issued_at timestamptz [note: '출고 확정 시각']
  issued_employee_id int [ref: > employee.id, note: '출고 확정자']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]

  indexes {
    customer_id
    issued_employee_id
  }

  Note: '출고 확정(Goods Issue)은 별도 테이블 없이 여기에 기록'
}

Table shipment_request_item {
  id int [pk, increment]
  shipment_request_id int [not null, ref: > shipment_request.id]
  sales_order_item_id int [not null, ref: > sales_order_item.id]
  request_qty int [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]

  indexes {
    (shipment_request_id, sales_order_item_id) [unique]
    sales_order_item_id
  }

  Note: '미배정 매수 = request_qty - 이 품목의 CONFIRMED 배정 수 (0보다 크면 배정 대기)'
}

Table mill_sheet {
  id int [pk, increment]
  mill_sheet_no varchar [unique, not null, note: 'MS-{출하요청 일련}-N']
  shipment_request_id int [not null, ref: > shipment_request.id]
  sales_order_id int [not null, ref: > sales_order.id]
  snapshot jsonb [not null, note: '발행 시점 고객사·수주·규격·LOT·히트·이론중량·검사값']
  pdf_path varchar [note: 'Storage 경로. PDF 버튼 클릭 시 생성']
  issued_at timestamptz [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]

  indexes {
    (shipment_request_id, sales_order_id) [unique]
    sales_order_id
  }

  Note: 'LOT 연결 테이블 없음: shipment_request -> shipment_request_item -> allocation(CONSUMED) -> lot'
}

// =====================================================================
// 4. 생산·LOT·품질
// =====================================================================

Table production_plan {
  id int [pk, increment]
  production_plan_no varchar [unique, not null, note: 'PP-YYMM-NNNN']
  sales_order_item_id int [ref: > sales_order_item.id, note: '수주 취소 시 null로 해제 -> 산출물은 여재']
  item_id int [not null, ref: > item.id, note: '생산 규격']
  shortage_qty int [not null]
  heat_count int [not null]
  is_reproduction boolean [not null, default: false]
  production_plan_status varchar [not null, default: 'PLANNED', note: 'PRODUCTION_PLAN_STATUS. PLANNED에서만 취소']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]

  indexes {
    sales_order_item_id
    item_id
  }

  Note: 'MRP 소요량은 저장하지 않음 (GET /mrp/requirements 계산 조회)'
}

Table production_result {
  id int [pk, increment]
  production_plan_id int [ref: > production_plan.id, note: '제선은 null']
  process_type varchar [not null, note: 'PROCESS_TYPE']
  blast_furnace_code varchar [note: '제선만. 예: BF2']
  converter_code varchar [note: '제강만. 예: BOF1']
  started_at timestamptz [not null]
  completed_at timestamptz [note: 'null이면 작업 중. 제선 원료 투입 기간 = started_at~completed_at']
  simulated_loss_rate decimal(5,4) [note: '실적 시뮬레이션만 (0~0.05)']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]

  indexes {
    production_plan_id
  }

  Note: 'CHECK: IRONMAKING이면 blast_furnace_code, STEELMAKING이면 converter_code 필수'
}

Table lot {
  id int [pk, increment]
  lot_no varchar [unique, not null, note: 'REQ-LOT-003 채번']
  lot_type varchar [not null, note: 'LOT_TYPE']
  item_id int [ref: > item.id, note: '원료·슬래브·코일']
  steel_grade_id int [ref: > steel_grade.id, note: '히트']
  production_result_id int [ref: > production_result.id, note: '원료 외. 자동 예약 대상은 실적 -> 계획 -> 수주 품목으로 찾음']
  goods_receipt_id int [unique, ref: - goods_receipt.id, note: '원료만. 입고 1건 = LOT 1개']
  yard_id int [ref: > yard.id, note: '원료·슬래브·코일']
  lot_status varchar [not null, default: 'AVAILABLE', note: 'LOT_STATUS']
  initial_ton decimal(12,3) [note: '원료(입고량)·용선·히트']
  remaining_ton decimal(12,3) [note: '원료·용선. 투입 시 차감']
  produced_date date [note: '슬래브·코일 생산완료일. 배정 FIFO 기준']
  disposition_status varchar [note: 'DISPOSITION_STATUS. 불합격 후 품질 담당이 지정']
  disposition_reason varchar
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]

  indexes {
    item_id
    steel_grade_id
    production_result_id
    yard_id
  }

  Note: '''
합격 여부(is_passed) 컬럼 없음. 판정은 quality_inspection.inspection_result
CHECK remaining_ton >= 0
CHECK (유형별 필수값)
- RAW_MATERIAL: item_id, goods_receipt_id, remaining_ton
- HOT_METAL: production_result_id, remaining_ton
- HEAT: steel_grade_id, production_result_id
- SLAB·COIL: item_id, production_result_id, produced_date
여재 = 적격 + AVAILABLE + CONFIRMED 배정 없는 SLAB LOT (저장하지 않음)
'''
}

Table lot_relation {
  id int [pk, increment]
  parent_lot_id int [not null, ref: > lot.id, note: '투입 LOT']
  child_lot_id int [not null, ref: > lot.id, note: '산출 LOT']
  lot_relation_evidence varchar [not null, note: 'LOT_RELATION_EVIDENCE: 원료->용선 PERIOD_BASED, 나머지 ACTUAL_INPUT']
  input_ton decimal(12,3) [note: '차감량 (원료->용선, 용선->히트, 합금철->히트)']
  input_started_at timestamptz [note: 'PERIOD_BASED만']
  input_ended_at timestamptz [note: 'PERIOD_BASED만']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]

  indexes {
    (parent_lot_id, child_lot_id) [unique]
    child_lot_id
  }

  Note: '''
CHECK parent_lot_id <> child_lot_id
용선->히트 N:M, 히트->슬래브 1:N, 슬래브->코일 1:1. LOT 번호 파싱으로 계보를 만들지 않음
'''
}

Table inspection_standard {
  id int [pk, increment]
  inspection_standard_code varchar [not null, note: '예: QS-SM355A-HR']
  version_no int [not null]
  process_type varchar [not null, note: 'PROCESS_TYPE']
  steel_grade_id int [not null, ref: > steel_grade.id]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]

  indexes {
    (inspection_standard_code, version_no) [unique]
    steel_grade_id
  }

  Note: '수정하지 않고 새 버전으로 추가. 제강 기준의 항목이 강종 성분 규격'
}

Table inspection_standard_item {
  id int [pk, increment]
  inspection_standard_id int [not null, ref: > inspection_standard.id]
  inspection_item_code varchar [not null, note: '예: C, SI, MN, YS, TS, EL, CVN']
  inspection_item_name varchar [not null]
  unit varchar
  min_value decimal(12,4) [note: '이상 (경계 포함)']
  max_value decimal(12,4) [note: '이하 (경계 포함)']
  thickness_over_mm decimal(8,2) [note: '적용 두께 초과']
  thickness_upto_mm decimal(8,2) [note: '적용 두께 이하']
  is_required boolean [not null, default: true, note: '누락 시 PENDING']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]

  indexes {
    inspection_standard_id
  }
}

Table quality_inspection {
  id int [pk, increment]
  lot_id int [unique, not null, ref: - lot.id, note: 'LOT당 1건']
  inspection_standard_id int [not null, ref: > inspection_standard.id, note: '판정에 쓴 기준 버전']
  inspection_result varchar [not null, default: 'PENDING', note: 'INSPECTION_RESULT: PENDING, PASS, FAIL']
  inspector_employee_id int [not null, ref: > employee.id]
  inspected_at timestamptz [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]

  indexes {
    inspection_standard_id
    inspector_employee_id
  }

  Note: '''
적격 계산: 슬래브 = 자기 PASS + 부모 히트 PASS, 코일 = 자기 PASS + 슬래브 경유 히트 PASS
밀시트 발행 후 측정값 수정 차단 (service)
'''
}

Table quality_inspection_value {
  id int [pk, increment]
  quality_inspection_id int [not null, ref: > quality_inspection.id]
  inspection_standard_item_id int [not null, ref: > inspection_standard_item.id]
  measured_value decimal(12,4) [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]

  indexes {
    (quality_inspection_id, inspection_standard_item_id) [unique]
    inspection_standard_item_id
  }

  Note: '보완·오타 수정은 같은 행 수정, 변경 전·후는 작업 로그'
}

// =====================================================================
// 5. 구매
// =====================================================================

Table purchase_requisition {
  id int [pk, increment]
  purchase_requisition_no varchar [unique, not null, note: 'PR-YYMM-NNNN']
  item_id int [not null, ref: > item.id, note: '원료 1품목']
  requested_ton decimal(12,3) [not null, note: 'required_ton(MRP 소요량)과 구분']
  desired_receipt_date date [not null]
  requester_id int [not null, ref: > employee.id]
  approver_id int [ref: > employee.id, note: '승인·반려한 부서장']
  approved_at timestamptz
  reject_reason varchar
  request_reason varchar
  production_plan_id int [ref: > production_plan.id, note: '근거 계획. MRP 중복 요청 방지']
  action_draft_id int [unique, ref: - action_draft.id, note: 'Message -> ERP 초안으로 생성된 경우']
  purchase_requisition_status varchar [not null, default: 'WAITING_APPROVAL', note: 'PURCHASE_REQUISITION_STATUS']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]

  indexes {
    item_id
    requester_id
    approver_id
    production_plan_id
  }

  Note: '''
CHECK requested_ton > 0
service: 승인자 = 요청자 소속 부서의 부서장. 반려 후 수정하면 WAITING_APPROVAL로 재요청
'''
}

Table purchase_order {
  id int [pk, increment]
  purchase_order_no varchar [unique, not null, note: 'PO-YYMM-NNNN']
  supplier_id int [not null, ref: > supplier.id, note: '공급업체 1곳당 발주 1건']
  purchase_order_status varchar [not null, default: 'CONFIRMED', note: 'PURCHASE_ORDER_STATUS']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]

  indexes {
    supplier_id
  }
}

Table purchase_order_item {
  id int [pk, increment]
  purchase_order_id int [not null, ref: > purchase_order.id]
  purchase_requisition_id int [unique, not null, ref: - purchase_requisition.id, note: '생성 시 구매요청 ORDERED']
  item_id int [not null, ref: > item.id]
  ordered_ton decimal(12,3) [not null]
  expected_receipt_date date [note: 'MRP 입고예정 필요일 판단용']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]

  indexes {
    purchase_order_id
    item_id
  }

  Note: '''
CHECK ordered_ton > 0
입고예정 = ordered_ton - 입고 합계 (저장하지 않음)
service: APPROVED 구매요청만, ordered_ton <= requested_ton
'''
}

Table goods_receipt {
  id int [pk, increment]
  goods_receipt_no varchar [unique, not null, note: 'GR-YYMM-NNNN']
  purchase_order_item_id int [not null, ref: > purchase_order_item.id]
  received_ton decimal(12,3) [not null]
  received_date date [not null, note: '원료 FIFO 기준']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]

  indexes {
    purchase_order_item_id
  }

  Note: '''
CHECK received_ton > 0
service: 입고 합계 <= ordered_ton (발주 품목 행 잠금). 등록이 곧 확정, 원료 LOT 생성
'''
}

// =====================================================================
// 6. 작업 로그·업무·알림·메신저·Action Draft
// =====================================================================

Table business_event {
  id int [pk, increment]
  business_event_no varchar [unique, not null, note: 'EV-YYMMDD-NNN']
  business_event_type varchar [not null, note: 'BUSINESS_EVENT_TYPE']
  actor_type varchar [not null, note: 'ACTOR_TYPE: USER, SYSTEM']
  actor_employee_id int [ref: > employee.id, note: 'SYSTEM이면 null']
  target_type varchar [not null, note: '대상 테이블명']
  target_id int [not null]
  sales_order_id int [ref: > sales_order.id, note: '수주 타임라인용']
  before_data jsonb [note: '비밀번호 해시·토큰 저장 금지']
  after_data jsonb
  reason varchar
  is_ai_assisted boolean [not null, default: false]
  action_draft_id int [ref: > action_draft.id]
  message_id int [ref: > message.id, note: '원본 메시지']
  created_at timestamptz [not null, default: `now()`, note: '발생 시각']
  updated_at timestamptz [not null]

  indexes {
    (target_type, target_id)
    sales_order_id
    actor_employee_id
    action_draft_id
    message_id
  }

  Note: '본 거래와 같은 트랜잭션에서 businessEventRecorder.record(tx, ...)로 기록'
}

Table business_event_lot {
  id int [pk, increment]
  business_event_id int [not null, ref: > business_event.id]
  lot_id int [not null, ref: > lot.id]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]

  indexes {
    (business_event_id, lot_id) [unique]
    lot_id
  }
}

Table task {
  id int [pk, increment]
  task_title varchar [not null]
  task_description text
  assignee_id int [not null, ref: > employee.id]
  due_date date [not null]
  task_status varchar [not null, default: 'OPEN', note: 'TASK_STATUS']
  message_id int [ref: > message.id, note: '메시지에서 등록한 업무의 원본 메시지 (스키마 2차)']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]

  indexes {
    assignee_id
    message_id
  }
}

Table notification {
  id int [pk, increment]
  notification_type varchar [not null, note: 'NOTIFICATION_TYPE']
  recipient_id int [not null, ref: > employee.id, note: '부서 알림은 발송 시 부서원별 행으로 펼침']
  notification_content varchar [not null]
  link_path varchar [note: 'ERP 화면 이동 경로']
  message_id int [ref: > message.id]
  business_event_id int [ref: > business_event.id]
  read_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]

  indexes {
    recipient_id
    message_id
    business_event_id
  }

  Note: '''
부분 unique (중복 알림 방지)
- (message_id, recipient_id) WHERE message_id IS NOT NULL
- (business_event_id, recipient_id) WHERE business_event_id IS NOT NULL
'''
}

Table chat_room {
  id int [pk, increment]
  chat_room_type varchar [not null, note: 'CHAT_ROOM_TYPE: DIRECT, GROUP, WORK']
  chat_room_name varchar
  sales_order_id int [ref: > sales_order.id, note: '업무방만']
  pinned_message_id int [ref: > message.id, note: '방 위에 고정한 공지 메시지 (스키마 2차)']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]

  indexes {
    sales_order_id
  }

  Note: 'CHECK: WORK면 sales_order_id 필수'
}

Table chat_room_member {
  id int [pk, increment]
  chat_room_id int [not null, ref: > chat_room.id]
  employee_id int [not null, ref: > employee.id]
  last_read_message_id int [ref: > message.id, note: '안 읽은 수 계산 기준']
  muted boolean [not null, default: false, note: '이 방 알림 끄기 (스키마 2차)']
  pinned_at timestamptz [note: '내 목록 위에 고정한 시각. null이면 고정 안 함 (스키마 2차)']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]

  indexes {
    (chat_room_id, employee_id) [unique]
    employee_id
    last_read_message_id
  }
}

Table message {
  id int [pk, increment]
  chat_room_id int [not null, ref: > chat_room.id]
  message_type varchar [not null, default: 'USER', note: 'MESSAGE_TYPE: USER, SYSTEM']
  sender_id int [ref: > employee.id, note: 'SYSTEM이면 null']
  content text
  attachment_path varchar [note: 'Storage 경로. 메시지 1건에 파일 1개']
  attachment_name varchar
  client_message_id varchar(64) [note: '화면이 만든 보내기 id(UUID). 재전송 중복 방지']
  parent_message_id int [ref: > message.id, note: '답글 대상. 같은 방 메시지만(service)']
  edited_at timestamptz [note: '본문을 마지막으로 고친 시각']
  deleted_at timestamptz [note: '삭제 표시. 행은 지우지 않음']
  created_at timestamptz [not null, default: `now()`, note: '발송 시각']
  updated_at timestamptz [not null]

  indexes {
    (chat_room_id, id)
    sender_id
    parent_message_id
  }

  Note: '''
  CHECK message_type = 'USER' → sender_id IS NOT NULL
  CHECK message_type = 'SYSTEM' → sender_id IS NULL
  부분 unique (sender_id, client_message_id) WHERE client_message_id IS NOT NULL
  '''
}

Table message_reaction {
  id int [pk, increment]
  message_id int [not null, ref: > message.id]
  employee_id int [not null, ref: > employee.id]
  emoji varchar(16) [not null, note: '허용 목록은 shared MESSAGE_REACTION_EMOJIS (스키마 2차)']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]

  indexes {
    (message_id, employee_id, emoji) [unique]
    employee_id
  }
}

Table action_draft {
  id int [pk, increment]
  action_type varchar [not null, note: 'ACTION_TYPE. P1은 PURCHASE_REQUISITION_CREATE']
  draft_status varchar [not null, default: 'AI_GENERATED', note: 'DRAFT_STATUS']
  payload jsonb [not null, note: '추출 스키마 값']
  message_id int [ref: > message.id, note: '추출 원본']
  requester_id int [ref: > employee.id, note: '확정 주체. 구매요청 초안은 메시지 작성자']
  confirmed_at timestamptz
  reject_reason varchar
  execution_error_code varchar [note: '핸들러 실행 실패. 상태는 추가하지 않음']
  execution_attempt_count int [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]

  indexes {
    message_id
    requester_id
  }

  Note: '''
부분 unique: (message_id, action_type)
  WHERE draft_status IN ('AI_GENERATED', 'WAITING_APPROVAL', 'APPROVED')  (미처리 초안 중복 방지)
결과는 생성된 업무 테이블의 action_draft_id로 연결 (purchase_requisition.action_draft_id)
'''
}

// =====================================================================
// 도메인 묶음
// =====================================================================

TableGroup org_auth {
  employee
  department
  job_grade
  role
  role_permission
}

TableGroup master_data {
  steel_grade
  item
  spec_mapping
  routing
  specific_consumption
  customer
  supplier
  yard
  production_setting
}

TableGroup sales_inventory_shipment {
  sales_order
  sales_order_item
  inventory
  reservation
  allocation
  shipment_request
  shipment_request_item
  mill_sheet
}

TableGroup production_lot_quality {
  production_plan
  production_result
  lot
  lot_relation
  inspection_standard
  inspection_standard_item
  quality_inspection
  quality_inspection_value
}

TableGroup purchasing {
  purchase_requisition
  purchase_order
  purchase_order_item
  goods_receipt
}

TableGroup log_collab_action {
  business_event
  business_event_lot
  task
  notification
  chat_room
  chat_room_member
  message
  action_draft
}
